<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Soulcrest</AssemblyName>
    <RootNamespace>Soulcrest.App</RootNamespace>
    <Product>Soulcrest</Product>
    <Title>Soulcrest</Title>
    <ApplicationIcon>wwwroot\soulcrest.ico</ApplicationIcon>
    <Description>Aion 2 Pet-Begleiter: Karte, Netzwerk-Loot-Tracker und Overlays</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="10.0.110" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="SharpPcap" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\en.json" />
    <EmbeddedResource Include="..\..\data\combat\title-labels.json" LogicalName="Soulcrest.CombatTitleLabels.json" Link="Data\title-labels.json" />
    <EmbeddedResource Include="..\..\data\combat\wing-labels.json" LogicalName="Soulcrest.CombatWingLabels.json" Link="Data\wing-labels.json" />
    <EmbeddedResource Include="..\..\data\combat\title-roster-estimate.json" LogicalName="Soulcrest.CombatTitleRosterEstimate.json" Link="Data\title-roster-estimate.json" />
    <EmbeddedResource Include="..\..\data\combat\title-unlocks.json" LogicalName="Soulcrest.CombatTitleUnlocks.json" Link="Data\title-unlocks.json" />
    <EmbeddedResource Include="..\..\data\achievements\definition-scopes.json" LogicalName="Soulcrest.AchievementDefinitionScopes.json" Link="Data\achievement-definition-scopes.json" />
    <EmbeddedResource Include="..\..\data\achievements\catalog.json" LogicalName="Soulcrest.CombatAchievementDisplayCatalog.json" Link="Data\achievement-catalog.json" />
    <EmbeddedResource Include="..\..\data\achievements\factions.json" LogicalName="Soulcrest.CombatAchievementFactions.json" Link="Data\achievement-factions.json" />
    <EmbeddedResource Include="..\..\data\achievements\progress-contracts.json" LogicalName="Soulcrest.CombatAchievementProgressContracts.json" Link="Data\achievement-progress-contracts.json" />
    <EmbeddedResource Include="..\..\data\achievements\progress-thresholds.json" LogicalName="Soulcrest.AchievementProgressThresholds.json" Link="Data\achievement-progress-thresholds.json" />
    <EmbeddedResource Include="..\..\data\achievements\reward-prefix-scopes.json" LogicalName="Soulcrest.CombatAchievementRewardScopes.json" Link="Data\achievement-reward-scopes.json" />
    <EmbeddedResource Include="Assets\lifeskill-item-names.json" LogicalName="Soulcrest.LifeskillItemNames.json" />
    <EmbeddedResource Include="..\..\data\loot-items.json" LogicalName="Soulcrest.LootItems.json" Link="Data\loot-items.json" />
    <EmbeddedResource Include="..\..\data\loot-icons.json" LogicalName="Soulcrest.LootIcons.json" Link="Data\loot-icons.json" />
    <EmbeddedResource Include="..\..\data\abyss-ranks.json" LogicalName="Soulcrest.AbyssRanks.json" Link="Data\abyss-ranks.json" />
    <EmbeddedResource Include="Assets\alert-standard.wav" LogicalName="Soulcrest.AlertStandard.wav" />
    <EmbeddedResource Include="Assets\loot-drop-standard.wav" LogicalName="Soulcrest.LootDropStandard.wav" />
    <EmbeddedResource Include="..\..\data\routes\leveling.soulroute" LogicalName="Soulcrest.LevelingRoutes.soulroute" Link="Routes\leveling.soulroute" />
    <EmbeddedResource Include="..\..\data\routes\dungeon-title-upgrades.json" LogicalName="Soulcrest.DungeonTitleUpgrades.json" Link="Routes\dungeon-title-upgrades.json" />
    <EmbeddedResource Include="..\..\docs\PATCHNOTES.md" LogicalName="Soulcrest.PATCHNOTES.md" Link="PATCHNOTES.md" />
    <EmbeddedResource Include="..\..\docs\PATCHNOTES.en.md" LogicalName="Soulcrest.PATCHNOTES.en.md" Link="PATCHNOTES.en.md" WithCulture="false" />
    <EmbeddedResource Include="Assets\esc-menu-icons.png" LogicalName="Soulcrest.EscMenuIcons.png" />
    <EmbeddedResource Include="Assets\map-window-emblem.png" LogicalName="Soulcrest.MapWindowEmblem.png" />
    <EmbeddedResource Include="Assets\AbyssRankMorphs\*.png" LogicalName="Soulcrest.AbyssRankMorphs.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\AbyssRankAudio\*.wav" LogicalName="Soulcrest.AbyssRankAudio.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\daevanion-node-round-mask.png" LogicalName="Soulcrest.DaevanionNodeRoundMask.png" />
    <EmbeddedResource Include="Assets\daevanion-node-background.png" LogicalName="Soulcrest.DaevanionNodeBackground.png" />
    <InternalsVisibleTo Include="Soulcrest.App.Tests" />
    <ProjectReference Include="..\Soulcrest.Core\Soulcrest.Core.csproj" />
    <ProjectReference Include="..\Soulcrest.Ocr\Soulcrest.Ocr.csproj" />
  </ItemGroup>

  <Target Name="ExcludeUnusedOpenCvVideoPlugin" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <!-- OpenCV is used for still images only (map tracking); the FFmpeg plugin is ~25 MB of nothing (as Grindcrest). -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.Filename)', '^opencv_videoio_ffmpeg[0-9]+_64$'))" />
    </ItemGroup>
  </Target>

  <!-- App-local Microsoft CRT: also bundled in single-file tester/portable builds. -->
  <Target Name="IncludeSoulcrestVcRuntime" AfterTargets="ComputeFilesToPublish" BeforeTargets="_ComputeFilesToBundle"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Resolve-VcRuntime.ps1&quot; -Directory &quot;$(SoulcrestVcRuntimeDirectory)&quot;"
          ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_SoulcrestVcRuntime" />
    </Exec>
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_SoulcrestVcRuntime)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
