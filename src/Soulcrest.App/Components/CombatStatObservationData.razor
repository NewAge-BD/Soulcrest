@if (Enabled && CombatStatObservationPresentation.Create(Snapshot) is { } observation)
{
    <script type="application/json" data-stat-observation>@((MarkupString)CombatStatObservationPresentation.Serialize(observation))</script>
}

@code {
    [Parameter] public CharacterCombatSnapshot Snapshot { get; set; } = CharacterCombatSnapshot.Empty;
    [Parameter] public bool Enabled { get; set; }
}
