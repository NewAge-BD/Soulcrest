@implements IDisposable
@inject SettingsService Settings
@inject UiState Ui
@inject TrackerService Tracker
@inject MapTrackingService Tracking
@inject ProgressService Progress
@inject AchievementStateService Achievements
@inject AchievementFavoriteService AchievementFavorites

<div class="shell">
    <header class="topbar" inert="@Ui.TutorialOpen">
        <div class="brand"><img class="brand-logo" src="soulcrest.png" alt="" /> Soulcrest <small title="@AppPaths.Version">Tester @ShortVersion</small></div>
        <nav class="tabs" aria-label="@UiText.T("Hauptnavigation")">
            <button type="button" class="@Active("map")" aria-current="@Current("map")" @onclick="@(() => Ui.Navigate("map"))">@UiText.T("Karte")</button>
            <button type="button" class="@Active("pets")" aria-current="@Current("pets")" @onclick="@(() => Ui.Navigate("pets"))">Pets</button>
            <button type="button" class="@Active("exploration")" aria-current="@Current("exploration")" title="@UiText.T("Fortschritt für Dungeons, Garnisonen und Kibelisken verwalten")" @onclick="@(() => Ui.Navigate("exploration"))">@UiText.T("Erkundungsfortschritt")</button>
            <button type="button" class="@Active("bossrush")" aria-current="@Current("bossrush")" @onclick="@(() => Ui.Navigate("bossrush"))">Boss Rush</button>
            <button type="button" class="@Active("loot")" aria-current="@Current("loot")" @onclick="@(() => Ui.Navigate("loot"))">Loot Tracker</button>
            <button type="button" class="@Active("combat-score")" aria-current="@Current("combat-score")" @onclick="@(() => Ui.Navigate("combat-score"))">Combat Score Calculator</button>
            <button type="button" class="@Active("alerts")" aria-current="@Current("alerts")" @onclick="@(() => Ui.Navigate("alerts"))">Alerts</button>
            <button type="button" class="@Active("overlay-editor")" aria-current="@Current("overlay-editor")" @onclick="@(() => Ui.Navigate("overlay-editor"))">Overlay Editor</button>
            <span class="tabs-sep" aria-hidden="true"></span>
            <button type="button" class="@Active("options")" aria-current="@Current("options")" @onclick="@(() => Ui.Navigate("options"))">@UiText.T("Optionen")</button>
            <button type="button" class="@Active("patchnotes")" aria-current="@Current("patchnotes")" @onclick="@(() => Ui.Navigate("patchnotes"))">@UiText.T("Patchnotes")</button>
            <button type="button" class="@Active("info")" aria-current="@Current("info")" @onclick="@(() => Ui.Navigate("info"))">Info</button>
        </nav>
        <div class="spacer"></div>
        <div class="topstatus">
            <button type="button" class="pill @(Tracking.Running ? (Tracking.Found ? "live" : Tracking.Paused ? "rest" : "warn") : "")" title="Player-Tracker: @UiText.T(Tracking.Status)" @onclick="@(() => Ui.Navigate("map"))">
                <span class="dot" aria-hidden="true"></span><span class="pill-label">@UiText.T("Spieler")</span>
                <span class="pill-value">@(Tracking.Running ? (Tracking.Found ? $"{Tracking.Fps} fps" : Tracking.Paused ? UiText.T("ruht") : UiText.T("sucht …")) : UiText.T("aus"))</span>
            </button>
            <button type="button" class="pill @(Tracker.Running ? "live" : "") @(Tracker.StatusIsError ? "error" : "")" title="@UiText.T("Netzwerk-Tracking"): @UiText.T(Tracker.Status)" @onclick="@(() => Ui.Navigate("options"))">
                <span class="dot" aria-hidden="true"></span><span class="pill-label">Loot</span>
                <span class="pill-value">@(Tracker.Running ? UiText.T("Netzwerk") : UiText.T("aus"))</span>
            </button>
            <span class="pill pill-count" title="@UiText.T("Pets im Katalog")">@Progress.Catalog.Pets.Count Pets</span>
        </div>
    </header>
    <main class="content" inert="@Ui.TutorialOpen">
        @if (Progress.MapDataDirectory is null)
        {
            @if (Ui.Tab == "map")
            {
                <div class="page"><div class="status error">@UiText.T("Kein Kartendatenpaket gefunden. Erwartet wird ein Ordner") <code>mapdata</code> @UiText.T("neben der EXE (siehe Info).")</div></div>
            }
        }
        else
        {
            <div class="maptab @(Ui.Tab == "map" ? "" : "off")"><MapView Active="@(Ui.Tab == "map")" /></div>
        }
        @if (Ui.Tab == "pets")
        {
            <PetsView />
        }
        else if (Ui.Tab == "exploration")
        {
            <ExplorationView Kind="all" />
        }
        else if (Ui.Tab == "bossrush")
        {
            <BossRushView />
        }
        else if (Ui.Tab == "loot")
        {
            <LootTrackerLiveView />
        }
        else if (Ui.Tab == "combat-score")
        {
            var achievementState = Achievements.View;
            <CombatScoreWorkspaceView Section="@Ui.CombatScoreSection" SectionChanged="Ui.ShowCombatScoreSection" AchievementState="achievementState" Faction="@Settings.Current.Faction"
                Favorites="AchievementFavorites.Get(achievementState.Binding)" ToggleFavorite="@((int familyId) => ToggleAchievementFavorite(achievementState.Binding, familyId))"
                ToggleTitleFavorite="@((int titleId) => ToggleTitleFavorite(achievementState.Binding, titleId))" OpenPets="@(() => Ui.Navigate("pets"))" OpenPetCategory="@((string genus) => { Ui.ShowPetCategory(genus); })" />
        }
        else if (Ui.Tab == "alerts")
        {
            <AlertsView />
        }
        else if (Ui.Tab == "overlay-editor")
        {
            <Soulcrest.App.Components.OverlayKit.OriginalKitOverlayEditor Section="@Ui.OverlayEditorSection" SectionChanged="Ui.ShowOverlayEditorSection" />
        }
        else if (Ui.Tab == "options")
        {
            <OptionsView />
        }
        else if (Ui.Tab == "patchnotes")
        {
            <PatchNotesView Language="@UiText.Language" />
        }
        else if (Ui.Tab == "info")
        {
            <InfoView />
        }
    </main>
    @if (Ui.TutorialOpen)
    {
        <TutorialView />
    }
    <UpdateNotice />
</div>

<OverlayLiveDiagnosticsData />
<AchievementTrackerObservationData />
<CraftingProficiencyObservationData />
<LootRecordingObservationData />

@code {
    private string Active(string tab) => Ui.Tab == tab ? "active" : "";
    private string? Current(string tab) => Ui.Tab == tab ? "page" : null;

    // "0.1.0+abc1234.tester20261002233000" -> "0.1.0 · abc1234"
    private static string ShortVersion
    {
        get
        {
            var parts = AppPaths.Version.Split('+', 2);
            if (parts.Length < 2)
                return parts[0];
            var revision = parts[1].Split('.')[0];
            return $"{parts[0]} · {revision[..Math.Min(7, revision.Length)]}";
        }
    }

    protected override void OnInitialized()
    {
        // First start after a fresh installation: enlarge and mark the minimap (user request 2026-10-07).
        if (!Settings.Current.TutorialDone && !SmokeTest.Enabled)
            Ui.OpenTutorial();
        Settings.Changed += Refresh;
        Ui.Changed += Refresh;
        Tracker.Changed += Refresh;
        Tracking.Changed += RefreshTracking;
        Achievements.Changed += Refresh;
        AchievementFavorites.Changed += Refresh;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            SmokeTest.UiRendered = true;
    }

    private Task ToggleAchievementFavorite(AchievementProfileBinding? binding, int familyId) => binding is null
        ? Task.CompletedTask : Task.Run(() => AchievementFavorites.Toggle(binding, familyId));

    private Task ToggleTitleFavorite(AchievementProfileBinding? binding, int titleId) => binding is null
        ? Task.CompletedTask : Task.Run(() => AchievementFavorites.ToggleTitle(binding, titleId));

    private void Refresh() => InvokeAsync(StateHasChanged);

    // Player positions arrive up to 10 times per second; the status pill only needs a few updates,
    // but a change of state (started, stopped, found, lost) shows at once.
    private DateTime _lastTrackingRender;
    private (bool Running, bool Found, bool Paused) _shownTracking;

    private void RefreshTracking()
    {
        var state = (Tracking.Running, Tracking.Found, Tracking.Paused);
        if (state == _shownTracking && DateTime.Now - _lastTrackingRender < TimeSpan.FromMilliseconds(500))
            return;
        _shownTracking = state;
        _lastTrackingRender = DateTime.Now;
        Refresh();
    }

    public void Dispose()
    {
        Settings.Changed -= Refresh;
        Ui.Changed -= Refresh;
        Tracker.Changed -= Refresh;
        Tracking.Changed -= RefreshTracking;
        Achievements.Changed -= Refresh;
        AchievementFavorites.Changed -= Refresh;
    }
}
