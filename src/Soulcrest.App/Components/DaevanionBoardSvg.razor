@using Soulcrest.Core.Daevanion
@using System.Globalization

<div class="dc-board-canvas" data-board-family="@Board.FamilyId">
    <svg viewBox="0 0 720 720" role="@(EditMode ? "group" : "img")" aria-label="@(EditMode ? UiText.F("{0}: aktuelle Nodes und lokale Änderungen", Board.Name.For(Language)) : UiText.F("{0}: geplante Route", Board.Name.For(Language)))" class="dc-board-svg">
        <defs><radialGradient id="dc-board-glow"><stop offset="0%" stop-color="#193d39" stop-opacity=".55" /><stop offset="100%" stop-color="#0c121a" stop-opacity="0" /></radialGradient></defs>
        <circle cx="360" cy="360" r="345" fill="url(#dc-board-glow)" />
        <g class="dc-board-grid" aria-hidden="true">
            @foreach (var node in Board.Nodes)
            {
                @foreach (var neighbor in Board.Nodes.Where(other => other.Id > node.Id && Math.Abs(other.Row - node.Row) + Math.Abs(other.Column - node.Column) == 1))
                {
                    <line x1="@X(node)" y1="@Y(node)" x2="@X(neighbor)" y2="@Y(neighbor)" />
                }
            }
        </g>
        <g class="dc-route-edges" aria-hidden="true">
            @foreach (var edge in Plan?.Edges.Where(_ => !EditMode) ?? [])
            {
                var from = Board.Nodes.FirstOrDefault(node => node.Id == edge.FromNodeId);
                var to = Board.Nodes.FirstOrDefault(node => node.Id == edge.ToNodeId);
                @if (from is not null && to is not null)
                {
                    <line x1="@X(from)" y1="@Y(from)" x2="@X(to)" y2="@Y(to)" />
                }
            }
        </g>
        @foreach (var node in Board.Nodes)
        {
            var chosen = EditMode ? DesiredNodeIds?.Contains(node.Id) == true : Plan?.NodeIds.Contains(node.Id) == true || node.Kind == DaevanionNodeKind.Start;
            var actual = ActualNodeIds?.Contains(node.Id) == true;
            var added = AddedNodeIds?.Contains(node.Id) == true;
            var removed = RemovedNodeIds?.Contains(node.Id) == true;
            var editable = CanEdit && node.Kind != DaevanionNodeKind.Start;
            var skill = node.Effects.FirstOrDefault()?.SkillId is int skillId ? Catalog.GetSkill(skillId) : null;
            var frame = Catalog.GetAsset(node.FrameAssetId);
            var icon = skill is not null ? Catalog.GetAsset(skill.ImageAssetId) : null;
            var order = Plan?.ActivationOrder.ToList().IndexOf(node.Id) ?? -1;
            <g class="dc-board-node @(chosen ? "dc-node-chosen" : "") @(SelectedNodeId == node.Id ? "dc-node-focus" : "") @(EditMode ? "db-edit-node" : "") @(EditMode && actual ? "db-node-actual" : "") @(EditMode && added ? "db-node-added" : "") @(EditMode && removed ? "db-node-removed" : "")" data-node-id="@node.Id" data-actual="@(EditMode ? actual.ToString().ToLowerInvariant() : null)" data-desired="@(EditMode ? chosen.ToString().ToLowerInvariant() : null)" data-added="@(EditMode ? added.ToString().ToLowerInvariant() : null)" data-removed="@(EditMode ? removed.ToString().ToLowerInvariant() : null)" tabindex="@(EditMode ? null : "0")" role="@(EditMode ? null : "button")" aria-label="@(EditMode ? null : Tooltip(node))" @onclick="@(() => EditMode ? Task.CompletedTask : NodeSelected.InvokeAsync(node.Id))" @onkeydown="@(args => EditMode ? Task.CompletedTask : OnNodeKey(args, node.Id))" @key="node.Id">
                <title>@Tooltip(node)</title>
                @if (chosen || EditMode && removed) { <circle class="dc-node-selection" cx="@X(node)" cy="@Y(node)" r="@(EditMode ? 21 : 19)" /> }
                @if (frame is not null) { <image href="@frame.Path" x="@(X(node) - 19)" y="@(Y(node) - 19)" width="38" height="38" /> }
                @if (icon is not null) { <g><image href="@icon.Path" x="@(X(node) - 12)" y="@(Y(node) - 12)" width="24" height="24" /><text x="@(X(node) + 9)" y="@(Y(node) + 16)" text-anchor="middle" class="dc-skill-increment">+1</text></g> }
                @if (node.Kind == DaevanionNodeKind.Start)
                {
                    <g><text x="@X(node)" y="@(Y(node) + 4)" text-anchor="middle" class="dc-node-start">◆</text></g>
                }
                else if (icon is null)
                {
                    @if (node.Effects.Count == 1)
                    {
                        <g><text x="@X(node)" y="@(Y(node) - 2)" text-anchor="middle" class="dc-node-stat-label" textLength="@LabelWidth(node.Effects[0])" lengthAdjust="spacingAndGlyphs">@node.Effects[0].ShortLabel.For(Language)</text><text x="@X(node)" y="@(Y(node) + 9)" text-anchor="middle" class="dc-node-stat">@node.Effects[0].DisplayAmount.For(Language)</text></g>
                    }
                    else
                    {
                        @for (var effectIndex = 0; effectIndex < node.Effects.Count; effectIndex++)
                        {
                            var effect = node.Effects[effectIndex];
                            <g><text x="@X(node)" y="@(Y(node) - 2 + effectIndex * 10)" text-anchor="middle" class="dc-node-stat-label" textLength="34" lengthAdjust="spacingAndGlyphs">@effect.ShortLabel.For(Language) @effect.DisplayAmount.For(Language)</text></g>
                        }
                    }
                }
                @if (!EditMode && ShowOrder && order > 0) { <g><circle cx="@(X(node) + 15)" cy="@(Y(node) - 15)" r="9" class="dc-order-bg" /><text x="@(X(node) + 15)" y="@(Y(node) - 12)" text-anchor="middle" class="dc-node-order">@order</text></g> }
                @if (EditMode)
                {
                    @if (added || removed)
                    {
                        <g aria-hidden="true"><circle class="db-delta-badge" cx="@(X(node) + 16)" cy="@(Y(node) - 16)" r="8" /><text class="db-delta-symbol" x="@(X(node) + 16)" y="@(Y(node) - 13)" text-anchor="middle">@(added ? "+" : "−")</text></g>
                    }
                    <foreignObject x="@(X(node) - 21)" y="@(Y(node) - 21)" width="42" height="42">
                        <button xmlns="http://www.w3.org/1999/xhtml" type="button" class="db-node-button" data-node-button="@node.Id" aria-label="@Tooltip(node)" aria-pressed="@chosen.ToString().ToLowerInvariant()" aria-disabled="@((!editable).ToString().ToLowerInvariant())" disabled="@(!editable)" tabindex="@(editable ? "0" : "-1")" @onclick="@(() => editable ? NodeSelected.InvokeAsync(node.Id) : Task.CompletedTask)" @onclick:stopPropagation="true"></button>
                    </foreignObject>
                }
            </g>
        }
    </svg>
</div>

@code {
    [Parameter, EditorRequired] public DaevanionBoard Board { get; set; } = null!;
    [Parameter] public DaevanionBoardPlan? Plan { get; set; }
    [Parameter] public string Language { get; set; } = "en";
    [Parameter] public int? SelectedNodeId { get; set; }
    [Parameter] public bool ShowOrder { get; set; }
    [Parameter] public EventCallback<int> NodeSelected { get; set; }
    [Parameter] public bool EditMode { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public IReadOnlySet<int>? ActualNodeIds { get; set; }
    [Parameter] public IReadOnlySet<int>? DesiredNodeIds { get; set; }
    [Parameter] public IReadOnlySet<int>? AddedNodeIds { get; set; }
    [Parameter] public IReadOnlySet<int>? RemovedNodeIds { get; set; }
    private static DaevanionCatalog Catalog => DaevanionCatalog.Default;
    private static int X(DaevanionNode node) => node.Column * 44 + 8;
    private static int Y(DaevanionNode node) => node.Row * 44 + 8;
    private int LabelWidth(DaevanionEffect effect) => Math.Min(34, effect.ShortLabel.For(Language).Length * 4);
    private string Tooltip(DaevanionNode node)
    {
        var title = node.Title.For(Language) + (node.Kind == DaevanionNodeKind.Start ? "" : " · " + string.Join(" · ", node.Effects.Select(effect => effect.ShortLabel.For(Language) + " " + effect.DisplayAmount.For(Language)))) + " · ";
        if (!EditMode) return title + UiText.T("CP hängt von Ausgangswerten und der gesamten Route ab.");
        var state = node.Kind == DaevanionNodeKind.Start ? "Startnode · fest" : AddedNodeIds?.Contains(node.Id) == true ? "Lokal hinzugefügt" : RemovedNodeIds?.Contains(node.Id) == true ? "Lokal entfernt · aktuell erkannt" : ActualNodeIds?.Contains(node.Id) == true ? "Aktuell erkannt" : "Nicht aktiviert";
        return title + UiText.T(state) + (CanEdit && node.Kind != DaevanionNodeKind.Start ? " · " + UiText.T("Linksklick: lokal umschalten") : "");
    }
    private Task OnNodeKey(KeyboardEventArgs args, int id) => args.Key is "Enter" or " " ? NodeSelected.InvokeAsync(id) : Task.CompletedTask;
}
