                            <button type="button" role="radio" class="@(option == color ? "on" : "")" aria-checked="@(option == color ? "true" : "false")" style="background:@option" title="@UiText.T(name)" aria-label="@UiText.T(name)" @onclick="@(() => SetRouteColor(route, option, name))"></button>
                        }
                    </div>
                }
            </article>
        }
