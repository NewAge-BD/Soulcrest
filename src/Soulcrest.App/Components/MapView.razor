    private PlayerPosition? _shownPosition;
    private bool _shownFound;


    private async Task ToggleFollow(ChangeEventArgs e)
    {
        Settings.Update(s => s.FollowPlayer = (bool)e.Value!);
        if (Settings.Current.FollowPlayer)
            await CenterOnPlayer();
    }

    private async Task CenterOnPlayer()
    {
        var position = ExplorationOverview.FreshPosition(ExplorationOverview.Capture(Tracking), DateTimeOffset.UtcNow);
        if (position is null) return; // a last-known Abyss position must not undo browsing after teleporting
        _trackedMap = position.MapId;
        if (position.MapId != _mapId)
            await SwitchMap(position.MapId, keepAt: position);
        await PushPlayer(force: true);
        await JS.InvokeVoidAsync("soulcrestMap.centerOnPlayer");
    }


    private DateTime _lastTrackingRender;

    // Positions arrive after full-frame validation: the marker follows each one, the sidebar and the
    // map controls re-render at most 4 times per second.
    // Positions arrive up to 10 times per second from the tracking thread. At most one push waits in the
    // queue: each one awaits the WebView, and while the game had the focus the calls piled up and Soulcrest
    // froze when clicked (user report 2026-10-05). The queued push always sends the latest position.
    private int _trackingQueued;

    private void OnTrackingChanged()
    {
        if (Interlocked.Exchange(ref _trackingQueued, 1) == 1)
            return;
        _ = InvokeAsync(async () =>
        {
            Volatile.Write(ref _trackingQueued, 0);
            if (_ready)
                await PushPlayer(force: false);
            if (DateTime.Now - _lastTrackingRender < TimeSpan.FromMilliseconds(250))
                return;
            _lastTrackingRender = DateTime.Now;
            StateHasChanged();
        });
    }

    private string? _trackedMap;

    private Task PushNavigationContext() => JS.InvokeVoidAsync("soulcrestMap.setNavigationContext",
        Tracking.ContextGeneration, Tracking.CanSelectProgression(_mapId)).AsTask();

    private async Task PushPlayer(bool force)
    {
        await PushNavigationContext();
        var snapshot = ExplorationOverview.Capture(Tracking);
        if (snapshot.Position is not { } position)
            return;
        var fresh = ExplorationOverview.FreshPosition(snapshot, DateTimeOffset.UtcNow);
        // Network Own already selects supported maps before visual acquisition. This also retains
        // the visual-only path with Network tracking off. A viewed foreign world map is never a move.
        var changedMap = fresh is not null && _trackedMap != fresh.MapId;
        if (!force && !changedMap && position == _shownPosition && (fresh is not null) == _shownFound)
            return;
        _shownPosition = position;
        _shownFound = fresh is not null;
        if (fresh is not null) _trackedMap = fresh.MapId;
        if (changedMap && fresh is not null && _maps.Any(m => m.Id == fresh.MapId)
            && (Settings.Current.FollowPlayer || Settings.Current.ProgressionEnabled))
        {
            if (Settings.Current.ProgressionEnabled)
            {
                Targets.SetProgression(null);
            }
            if (fresh.MapId != _mapId)
            {
                await SwitchMap(fresh.MapId, keepAt: fresh);
                return; // ShowMap draws the fresh player and rebuilds progression for this map.
            }
            if (Settings.Current.ProgressionEnabled)
            {
                // The user may already have browsed to the destination map. Reload its own payload
                // once so JS reissues guidance even when the same target was previously a preview.
                await ShowMap(keepAt: fresh);
                return;
            }
        }
        var started = System.Diagnostics.Stopwatch.GetTimestamp();
        if (position.ContextGeneration != Tracking.ContextGeneration) fresh = null;
        await JS.InvokeVoidAsync("soulcrestMap.setPlayer", position.MapId, position.X, position.Y,
            Settings.Current.FollowPlayer && Active && fresh is not null, fresh is not null, position.ContextGeneration);
        var took = System.Diagnostics.Stopwatch.GetElapsedTime(started);
        if (took > TimeSpan.FromMilliseconds(500))
            UiResponsiveness.Record("Kartenseite", took, $"Spielerposition, Karte {_mapId}, Tab {(Active ? "Karte" : "anderer")}, Vordergrund: {UiResponsiveness.ForegroundProcess()}");
    }

    private static bool LivesOn(PetDefinition pet, string mapId) =>
        pet.Spawns.GetValueOrDefault(mapId) + pet.Monsters.GetValueOrDefault(mapId) > 0;

    private string ReadManifest() => File.ReadAllText(Path.Combine(Progress.MapDataDirectory!, "manifest.json"));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("soulcrestMap.init", "map", ReadManifest(), BaseUrl, _self);
            string requestedMap;
            do
            {
                requestedMap = _mapId;
                await ShowMap();
            } while (!_disposed && requestedMap != _mapId);
            _ready = !_disposed;
        }
        if (_relayout && _ready)
        {
            _relayout = false;
            await JS.InvokeVoidAsync("soulcrestMap.invalidate");
        }
        if (Active && !_wasActive && _ready)
        {
            await JS.InvokeVoidAsync("soulcrestMap.invalidate");
            if (Ui.TakePendingBossFocus() is { } boss) await FlyToTarget(boss);
            if (Ui.TakePendingPetFocus() is { } pet)
            {
                // Switch to a map where the pet actually lives.
                var definition = Progress.Catalog.Find(pet);
                if (definition is not null && !LivesOn(definition, _mapId) && _maps.FirstOrDefault(m => LivesOn(definition, m.Id)) is { } other)
                    await SwitchMap(other.Id);
                await FocusPet(pet);
            }
        }
        if (Active && _ready && Ui.TakePendingExplorationFocus() is { } place)
            await FocusExploration(place);
        if (Active && _ready && Ui.TakePendingLootRouteFocus() is { } route)
            await FocusLootRoute(route);
        _wasActive = Active;
    }

    internal async Task FocusLootRoute(LootTrackerMapFocus requested)
    {
        if (!_maps.Any(map => map.Id == requested.MapId))
        {
            _error = "Keine passende Offlinekarte für diese Route verfügbar.";
            StateHasChanged();
            return;
        }
        // A missing historical map must not block a later valid route on the current map.
        if (_error == "Keine passende Offlinekarte für diese Route verfügbar.") _error = null;
        // As with explicit catalogue focus, a known player location must not immediately undo
        // the user's selected historical map. Actual subsequent map changes retain their policy.
        _trackedMap = Tracking.Position?.MapId ?? _trackedMap;
        if (_mapId != requested.MapId) await SwitchMap(requested.MapId);
        if (_mapId != requested.MapId || _error is not null) return;
        _lootRouteFocus = requested;
        await PushLootRouteFocus(fit: true);
        StateHasChanged();
    }

    private Task PushLootRouteFocus(bool fit = false) => _lootRouteFocus is { } route && route.MapId == _mapId
        ? JS.InvokeVoidAsync("soulcrestMap.setLootRoute", route.MapId,
            JsonSerializer.Serialize(route.Segments.Select(segment => segment.Points.Select(point => new { x = point.X, y = point.Y }))),
            route.Name, fit,
            JsonSerializer.Serialize(route.Markers.Where(marker => marker.MapId == route.MapId && LootMarkerVisible(marker.KindKey))
                .Select(marker => new { x = marker.X, y = marker.Y, kind = marker.KindKey, tooltip = marker.Tooltip }))).AsTask()
        : Task.CompletedTask;

    private bool LootMarkerVisible(string kind) => kind switch
    {
        "kill" => _lootShowKills,
        "death" => _lootShowDeaths,
        "odyle" or "gathering" => _lootShowOdyle,
        _ => false
    };

    private async Task SetLootMarkerVisible(string kind, bool visible)
    {
        switch (kind)
        {
            case "kill": _lootShowKills = visible; break;
            case "death": _lootShowDeaths = visible; break;
            case "odyle":
            case "gathering": _lootShowOdyle = visible; break;
            default: return;
        }
        await PushLootRouteFocus();
    }

    private async Task ClearLootRouteFocus()
    {
        _lootRouteFocus = null;
        await JS.InvokeVoidAsync("soulcrestMap.clearLootRoute");
    }

    /// <summary>Uses the catalogue marker on its own map; no boss preview, target or completion is changed.</summary>
    internal async Task FocusExploration(ExplorationPlace requested)
    {
        var place = Exploration.Places.FirstOrDefault(p => p.Id == requested.Id);
        if (place is null || !_maps.Any(m => m.Id == place.Map) || place.Marker < 0
            || !double.IsFinite(place.X) || !double.IsFinite(place.Y)) return;
        // Like a map picked by hand, this focus remains until the player actually changes maps.
        // Otherwise ShowMap's first player push could immediately switch back before Marker is used.
        _trackedMap = Tracking.Position?.MapId ?? _trackedMap;
        if (_mapId != place.Map) await SwitchMap(place.Map);
        if (_mapId != place.Map || _error is not null) return;
        await FlyTo(place.Marker);
    }

    private long _mapPresentationRevision;
    private readonly Dictionary<string, long> _mapViewRevisions = new(StringComparer.Ordinal);

    [JSInvokable]
    public void MapViewChanged(string mapId, double x, double y, double zoom, long revision)
    {
        if (_disposed || string.IsNullOrWhiteSpace(mapId) || !_mapViewRevisions.TryGetValue(mapId, out var expected) || revision != expected
            || !_maps.Any(m => m.Id == mapId)) return;
        var viewport = new MapViewport(x, y, zoom);
        if (!viewport.IsValid() || Settings.Current.MapViewports.GetValueOrDefault(mapId) == viewport) return;
        // A late callback may save its own outgoing map, but may never overwrite a newer visit.
        Settings.Update(s => s.MapViewports = new Dictionary<string, MapViewport>(s.MapViewports, StringComparer.Ordinal)
            { [mapId] = viewport });
    }

    private async Task ShowMap(PlayerPosition? keepAt = null)
    {
        var revision = ++_mapPresentationRevision;
        var shownMap = _mapId;
        _mapViewRevisions[shownMap] = revision;
        bool Current() => !_disposed && revision == _mapPresentationRevision && shownMap == _mapId;
        try
        {
            _error = null;
            await PushDone();
            if (!Current()) return;
            var json = await JS.InvokeAsync<string>("soulcrestMap.show", shownMap, Settings.Current.NameLanguage,
                keepAt is null ? null : new { x = keepAt.X, y = keepAt.Y },
                new { savedView = Settings.Current.MapViewports.GetValueOrDefault(shownMap), revision });
            if (!Current()) return;
            var result = JsonSerializer.Deserialize<ShowResult>(json, Json)!;
            if (result.Cancelled) return;
            _groups = result.Groups;
            _markerCount = result.Markers;
            _visible.Clear();
            foreach (var cat in _groups.SelectMany(g => g.Categories).Where(c => !c.Hidden))
                _visible.Add(cat.Index);
            await RestoreCategories();
            if (!Current()) return;
            _focus = null;
            _monsterFocus = null;
            _focusNote = null;
            _results = [];
            _monsterResults.Clear();
            ++_searchRevision;
            SmokeTest.MapShown = _markerCount > 0;
            _shownPosition = null;
            await PushTargets();
            if (!Current()) return;
            await PushBossTimers();
            if (!Current()) return;
            await PushProgression();
            if (!Current()) return;
            await PushPlayer(force: true);
            if (!Current()) return;
            await PushLootRouteFocus();
        }
        catch (JSException exception)
        {
            if (!Current()) return;
            _error = exception.Message;
            SmokeTest.Error = exception.Message;
        }
        if (Current()) StateHasChanged();
    }

    /// <param name="keepAt">Player position when the tracking changed maps: the zoom is kept.</param>
    private async Task SwitchMap(string id, PlayerPosition? keepAt = null)
    {
        if (id == _mapId || !_maps.Any(m => m.Id == id))
            return;
        _results = [];
        _monsterResults.Clear();
        ++_searchRevision;
        _mapId = id;
        _lootRouteFocus = null;
        Settings.Update(s => s.LastMap = id);
        await ShowMap(keepAt);
    }

    private async Task SetCategory(int index, bool visible)
    {
        await ShowCategory(index, visible);
        SaveCategories();
    }

    private async Task SetGroup(Group group, bool visible)
    {
        foreach (var cat in group.Categories)
            await ShowCategory(cat.Index, visible);
        SaveCategories();
    }

    private static readonly MapSurface[] LegendSurfaces = [MapSurface.Minimap, MapSurface.Interactive, MapSurface.Worldmap];
    private static string SurfaceLabel(MapSurface surface) => UiText.T(surface switch { MapSurface.Minimap => "Minimap", MapSurface.Worldmap => "Worldmap", _ => "Interaktive Karte" });
    private bool CategoryVisible(Group group, Category cat, MapSurface surface) => surface == MapSurface.Interactive
        ? _visible.Contains(cat.Index) : MapLayerVisibility.CategoryVisible(Settings.Current, _mapId, surface, group.Name, cat.Name);
    private bool KindVisible(Group group, Category cat, string kind, MapSurface surface) => surface == MapSurface.Interactive
        ? _visible.Contains(cat.Index) && !_hiddenKinds.Contains(KindKey(group, cat, kind))
        : MapLayerVisibility.KindVisible(Settings.Current, _mapId, surface, group.Name, cat.Name, kind);

    // Freeze both legacy native views before the first legend edit. Changing the interactive view
    // must never change a native view still using its legacy fallback.
    private void EnsureNativeSelections()
    {
        var settings = Settings.Current;
        if (settings.MapMinimapLayers.ContainsKey(_mapId) && settings.MapWorldmapLayers.ContainsKey(_mapId)) return;
        MapLayerSelection Snapshot(MapSurface surface) => new(
            _groups.SelectMany(g => g.Categories.Where(c => MapLayerVisibility.CategoryVisible(settings, _mapId, surface, g.Name, c.Name))
                .Select(c => MapPetMarkers.CategoryKey(g.Name, c.Name))).Distinct(StringComparer.Ordinal).ToArray(),
            settings.MapHiddenKinds.GetValueOrDefault(_mapId) ?? []);
        var mini = Snapshot(MapSurface.Minimap); var world = Snapshot(MapSurface.Worldmap); var map = _mapId;
        Settings.Update(s => {
            if (!s.MapMinimapLayers.ContainsKey(map)) s.MapMinimapLayers = new(s.MapMinimapLayers) { [map] = mini };
            if (!s.MapWorldmapLayers.ContainsKey(map)) s.MapWorldmapLayers = new(s.MapWorldmapLayers) { [map] = world };
        });
    }

    private async Task SetSurfaceCategory(Group group, Category cat, MapSurface surface, bool visible)
    {
        if (surface == MapSurface.Interactive) { await SetCategory(cat.Index, visible); return; }
        ChangeNative(surface, (categories, _) => { if (visible) categories.Add(MapPetMarkers.CategoryKey(group.Name, cat.Name)); else categories.Remove(MapPetMarkers.CategoryKey(group.Name, cat.Name)); });
    }
    private async Task SetSurfaceGroup(Group group, MapSurface surface, bool visible)
    {
        if (surface == MapSurface.Interactive) { await SetGroup(group, visible); return; }
        ChangeNative(surface, (categories, _) => { foreach (var cat in group.Categories) { var key = MapPetMarkers.CategoryKey(group.Name, cat.Name); if (visible) categories.Add(key); else categories.Remove(key); } });
    }
    private async Task SetSurfaceKind(Group group, Category cat, string kind, MapSurface surface, bool visible)
    {
        if (surface == MapSurface.Interactive) { await SetKind(group, cat, kind, visible); return; }
        ChangeNative(surface, (categories, hidden) => {
            var key = KindKey(group, cat, kind); var category = MapPetMarkers.CategoryKey(group.Name, cat.Name);
            if (visible) {
                hidden.Remove(key);
                if (categories.Add(category)) foreach (var other in cat.Kinds ?? []) if (other.Name != kind) hidden.Add(KindKey(group, cat, other.Name));
            } else hidden.Add(key);
        });
    }
    private void ChangeNative(MapSurface surface, Action<HashSet<string>, HashSet<string>> change)
    {
        EnsureNativeSelections();
        var selection = MapLayerVisibility.Selection(Settings.Current, _mapId, surface)!;
        var categories = selection.Categories.ToHashSet(StringComparer.Ordinal); var hidden = selection.HiddenKinds.ToHashSet(StringComparer.Ordinal);
        change(categories, hidden);
        var next = new MapLayerSelection(categories.Order(StringComparer.Ordinal).ToArray(), hidden.Order(StringComparer.Ordinal).ToArray()); var map = _mapId;
        Settings.Update(s => { if (surface == MapSurface.Minimap) s.MapMinimapLayers = new(s.MapMinimapLayers) { [map] = next }; else s.MapWorldmapLayers = new(s.MapWorldmapLayers) { [map] = next }; });
    }

    private async Task ShowCategory(int index, bool visible)
    {
        if (visible) _visible.Add(index); else _visible.Remove(index);
        await JS.InvokeVoidAsync("soulcrestMap.setCategoryVisible", index, visible);
    }

    /// <summary>
    /// The interactive legend selection is kept per map, independently of both native surfaces.
    /// </summary>
    private void SaveCategories()
    {
        EnsureNativeSelections();
        var shown = _groups.SelectMany(g => g.Categories.Where(c => _visible.Contains(c.Index)).Select(c => MapPetMarkers.CategoryKey(g.Name, c.Name)))
            .Distinct().ToArray();
        var map = _mapId;
        Settings.Update(s => s.MapCategories = new Dictionary<string, string[]>(s.MapCategories) { [map] = shown });
    }

    /// <summary>Shows or hides one resource kind; showing it also shows its category.</summary>
    private async Task SetKind(Group group, Category cat, string kind, bool visible)
    {
        var key = KindKey(group, cat, kind);
        if (visible) _hiddenKinds.Remove(key); else _hiddenKinds.Add(key);
        await JS.InvokeVoidAsync("soulcrestMap.setKindVisible", cat.Index, kind, visible);
        if (visible && !_visible.Contains(cat.Index))
        {
            // Category was off: show just this kind, as a click on a single entry means.
            foreach (var other in cat.Kinds ?? [])
            {
                if (other.Name == kind) continue;
                _hiddenKinds.Add(KindKey(group, cat, other.Name));
                await JS.InvokeVoidAsync("soulcrestMap.setKindVisible", cat.Index, other.Name, false);
            }
            await ShowCategory(cat.Index, true);
            SaveCategories();
        }
        SaveKinds();
    }

    private void SaveKinds()
    {
        EnsureNativeSelections();
        var hidden = _hiddenKinds.Order(StringComparer.Ordinal).ToArray();
        var map = _mapId;
        Settings.Update(s => s.MapHiddenKinds = new Dictionary<string, string[]>(s.MapHiddenKinds) { [map] = hidden });
    }

    [JSInvokable]
    public void OnKindShown(int index, string kind)
    {
        foreach (var group in _groups)
            foreach (var cat in group.Categories.Where(c => c.Index == index))
                _hiddenKinds.Remove(KindKey(group, cat, kind));
        SaveKinds();
        StateHasChanged();
    }

    private async Task RestoreCategories()
    {
        var shownMap = _mapId;
        var revision = _mapPresentationRevision;
        var groups = _groups;
        bool Current() => !_disposed && shownMap == _mapId && revision == _mapPresentationRevision;
        _hiddenKinds.Clear();
        if (Settings.Current.MapHiddenKinds.TryGetValue(shownMap, out var hiddenKinds))
        {
            foreach (var group in groups)
                foreach (var cat in group.Categories)
                    foreach (var kind in cat.Kinds ?? [])
                    {
                        if (!Current()) return;
                        var key = KindKey(group, cat, kind.Name);
                        if (!hiddenKinds.Contains(key)) continue;
                        _hiddenKinds.Add(key);
                        await JS.InvokeVoidAsync("soulcrestMap.setKindVisible", cat.Index, kind.Name, false);
                        if (!Current()) return;
                    }
        }
        if (!Current() || !Settings.Current.MapCategories.TryGetValue(shownMap, out var saved))
            return; // never changed on this map: the data package's defaults
        var shown = saved.ToHashSet();
        foreach (var group in groups)
            foreach (var cat in group.Categories)
            {
                if (!Current()) return;
                var visible = shown.Contains(MapPetMarkers.CategoryKey(group.Name, cat.Name));
                if (visible != _visible.Contains(cat.Index))
                {
                    await ShowCategory(cat.Index, visible);
                    if (!Current()) return;
                }
            }
    }

    private void ToggleGroupOpen(string name)
    {
