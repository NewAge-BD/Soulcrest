            _open.Add(name);
    }

    private async Task Search()
    {
        var revision = ++_searchRevision;
        var query = _query;
        var language = Settings.Current.NameLanguage;
        var map = _mapId;
        if (query.Trim().Length < 2)
        {
            _results = [];
            _monsterResults.Clear();
            return;
        }
        // The index reads only the local package, once, away from the renderer thread.
        var monsters = await Task.Run(() => _monsterSearch?.Search(query, language) ?? []);
        if (revision != _searchRevision || map != _mapId) return;
        var json = await JS.InvokeAsync<string>("soulcrestMap.search", query);
        if (revision != _searchRevision || map != _mapId) return;
        var local = JsonSerializer.Deserialize<List<SearchHit>>(json, Json) ?? [];
        _monsterResults = monsters.ToDictionary(match => match.Key, StringComparer.Ordinal);
        var monsterNames = monsters.ToDictionary(match => match.DisplayName(language), StringComparer.OrdinalIgnoreCase);
        bool SamePet(SearchHit hit) => hit.Group == "Pets" && hit.PetId is { } id
            && Progress.Catalog.Find(id) is { } pet && monsterNames.TryGetValue(hit.Name, out var match)
            && match.PetIds.Contains(pet.Id, StringComparer.Ordinal);
        _results = monsters.Select(match => new SearchHit(-1, match.DisplayName(language), UiText.T("Monster"), true, match.Key))
            .Concat(local.Where(hit => !hit.Monster && !SamePet(hit)))
            .Take(40).ToList();
    }

    private async Task SelectSearchHit(SearchHit hit)
    {
        if (_searchBusy || !_results.Contains(hit)) return;
        if (!hit.Monster)
        {
            _monsterFocus = null;
            await FlyTo(hit.I);
            return;
        }
        if (hit.Key is null || !_monsterResults.TryGetValue(hit.Key, out var monster)) return;
        var preferred = MapMonsterSearch.PreferredMap(monster, _mapId, ExplorationOverview.Capture(Tracking), DateTimeOffset.UtcNow);
        await FocusMonster(monster, preferred);
    }

    private async Task SwitchMonsterMap(string map)
    {
        if (_searchBusy || _monsterFocus is not { } monster || !MonsterFarmMaps.Any(option => option.Id == map)) return;
        await FocusMonster(monster, map);
    }

    private async Task FocusMonster(MonsterSearchMatch monster, string map)
    {
        _searchBusy = true;
        _results = [];
        ++_searchRevision;
        StateHasChanged();
        try
        {
            // Explicit browsing, like exploration focus, survives the next same-map player push.
            _trackedMap = Tracking.Position?.MapId ?? _trackedMap;
            if (_mapId != map) await SwitchMap(map);
            if (_mapId != map || _error is not null) return;
            _monsterFocus = monster;
            _focus = monster.DisplayName(Settings.Current.NameLanguage);
            if (monster.Maps.Contains(map, StringComparer.Ordinal))
            {
                var count = await JS.InvokeAsync<int>("soulcrestMap.focusMonster", (object)monster.Names);
                _focusNote = UiText.F("{0} Fundorte auf {1} hervorgehoben", count, MapLabel);
            }
            else
            {
                // Other sourced farm maps can contain a different monster dropping the same pet's soul.
                var farmPets = monster.PetIds.Select(id => Progress.Catalog.Find(id)).OfType<PetDefinition>()
                    .Where(p => LivesOn(p, map)).Select(p => p.Id).ToHashSet(StringComparer.Ordinal);
                var petIds = farmPets.Concat(Progress.Catalog.Aliases.Where(alias => farmPets.Contains(alias.Value))
                    .Select(alias => alias.Key)).Distinct(StringComparer.Ordinal).ToArray();
                if (petIds.Length > 0)
                {
                    var json = await JS.InvokeAsync<string>("soulcrestMap.focusPet", petIds, true);
                    var counts = JsonSerializer.Deserialize<PetFocusCount>(json, Json);
                    _focusNote = UiText.F("Farmorte des Pets: {0} Pet-Spawns · {1} Quellmonster auf {2}", counts?.Pets ?? 0, counts?.Monsters ?? 0, MapLabel);
                }
            }
        }
        catch (JSException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _searchBusy = false;
            StateHasChanged();
        }
    }

    private async Task FlyTo(int index)
    {
        _monsterFocus = null;
        await JS.InvokeAsync<string>("soulcrestMap.flyToMarker", index);
