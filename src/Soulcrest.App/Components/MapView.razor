@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ProgressService Progress
@inject SettingsService Settings
@inject UiState Ui
@inject MapTrackingService Tracking
@inject MapTargetsService Targets
@inject TrackerService Loot
@inject ExplorationService Exploration
@inject IServiceProvider Services

@* Layers on the left, everything else on the right; both fold away (user request 2026-10-06). *@
<div class="mapview @(_sideCollapsed ? "left-collapsed" : "") @(_rightCollapsed ? "right-collapsed" : "")">
    <aside class="sidebar mapside mapside-left">
        <div class="side-top">
            <select class="mapselect" title="@UiText.T("Karte wählen")" value="@_mapId" @onchange="@(e => SwitchMap(e.Value!.ToString()!))">
                @foreach (var group in _maps.GroupBy(m => m.Group))
                {
                    <optgroup label="@UiText.T(group.Key)">
                        @foreach (var map in group)
                        {
                            <option value="@map.Id">@UiText.T(map.Label)</option>
                        }
                    </optgroup>
                }
            </select>
            <input class="search" type="text" disabled="@_searchBusy" aria-busy="@_searchBusy.ToString().ToLowerInvariant()" autocomplete="off" spellcheck="false" placeholder="@UiText.T("Suchen: Pet, Monster, Ort …")" @bind="_query" @bind:event="oninput" @bind:after="Search" />
        </div>
        @if (_results.Count > 0)
        {
            <div class="searchresults">
                @foreach (var r in _results)
                {
                    <button type="button" disabled="@_searchBusy" @onclick="@(() => SelectSearchHit(r))">@r.Name <small>· @r.Cat</small></button>
                }
            </div>
        }
        @if (_searchBusy && _monsterFocus is null)
        {
            <div class="status" role="status">@UiText.T("Spawnpunkte werden angezeigt …")</div>
        }
        @if (_monsterFocus is not null)
        {
            <MonsterSearchCard Monster="_monsterFocus" SpawnMaps="MonsterFarmMaps" MapId="_mapId" SpawnNote="@(_focusNote ?? "")" Busy="_searchBusy" MapChanged="SwitchMonsterMap" Clear="ClearFocus" />
        }
        else if (_focus is not null)
        {
            <div class="focusbox">
                <div class="box-head">
                    <span class="box-title" title="@_focus">@_focus</span>
                    <button type="button" class="btn small" title="@UiText.T("Hervorhebung aufheben")" @onclick="ClearFocus">@UiText.T("Aufheben")</button>
                </div>
                <div class="note">@(_focusNote ?? UiText.F("{0} Pet-Spawns · {1} Quellmonster auf {2}", _focusPets, _focusMonsters, MapLabel))</div>
            </div>
        }
        @if (_error is not null)
        {
            <div class="status error">@UiText.T(_error)</div>
        }
        @if (_lootRouteFocus is { } routeFocus)
        {
            <div class="focusbox" data-loot-route-session="@routeFocus.SessionId">
                <div class="box-head">
                    <span class="box-title" title="@routeFocus.Name">@(string.IsNullOrWhiteSpace(routeFocus.Name) ? UiText.T("Routenvorschau") : routeFocus.Name)</span>
                    <button type="button" class="btn small" title="@UiText.T("Routenvorschau aufheben")" @onclick="ClearLootRouteFocus">@UiText.T("Aufheben")</button>
                </div>
                <div class="note">@UiText.F("Aufgezeichnete Sessionroute · {0} Abschnitte", routeFocus.Segments.Length)</div>
                @if (routeFocus.Markers.Count > 0)
                {
                    <div class="pet-level-options">
                        <label class="chip"><input type="checkbox" checked="@_lootShowKills" @onchange="@(e => SetLootMarkerVisible("kill", (bool)e.Value!))" /> @UiText.T("Spielerkills")</label>
                        <label class="chip"><input type="checkbox" checked="@_lootShowDeaths" @onchange="@(e => SetLootMarkerVisible("death", (bool)e.Value!))" /> @UiText.T("Eigene Tode")</label>
                        <label class="chip"><input type="checkbox" checked="@_lootShowOdyle" @onchange="@(e => SetLootMarkerVisible("gathering", (bool)e.Value!))" /> @UiText.T("Sammelstellen")</label>
                    </div>
                }
            </div>
        }

        <h3 class="layers-head"><span>@UiText.T("Ebenen")</span> <small>@_markerCount Marker</small>
            <InfoTip>@UiText.T("Monster-Ebenen sind anfangs ausgeblendet. Ein Pet aus der Pet-Liste („Karte“) hebt seine Spawns und Quellmonster hervor.")</InfoTip></h3>
        <div class="legend-surfaces" aria-hidden="true"><span>@UiText.T("Anzeigen auf")</span><abbr title="@UiText.T("Minimap")">@UiText.T("Minimap")</abbr><abbr title="@UiText.T("Interaktive Karte")">@UiText.T("Karte")</abbr><abbr title="@UiText.T("Worldmap")">@UiText.T("Worldmap")</abbr></div>
        <div class="map-overlay-shortcut"><OverlaySettingsLink OverlayId="map" /></div>
        <div class="layers">
            @foreach (var group in _groups)
            {
                <div class="group">
                    <div class="group-head legend-row">
                        <button type="button" class="legend-name" aria-expanded="@_open.Contains(group.Name)" @onclick="@(() => ToggleGroupOpen(group.Name))"><span class="caret">@(_open.Contains(group.Name) ? "▾" : "▸")</span><span class="name">@group.Name</span><span class="count">@group.Categories.Where(c => group.Name != "Collectibles" || c.Name != "Cube Groups").Sum(c => c.Count)</span></button>
                        @foreach (var surface in LegendSurfaces)
                        {
                            <label class="legend-choice" title="@SurfaceLabel(surface)"><input type="checkbox" aria-label="@UiText.F("{0} auf {1} anzeigen", group.Name, SurfaceLabel(surface))" checked="@group.Categories.All(c => CategoryVisible(group, c, surface))" @onchange="@(e => SetSurfaceGroup(group, surface, (bool)e.Value!))" /></label>
                        }
                    </div>
                    @if (group.Name == "Pets")
                    {
                        @* User request 2026-10-14: checked means shown, with exclusivity kept separate. *@
                        <div class="pet-filters">
                            <div class="pet-level-heading">
                                <span class="field-label">@UiText.T("Stufen anzeigen")</span>
                                <InfoTip>
                                    <p>@UiText.T("Angehakte Stufen werden angezeigt. Entferne einen Haken, um Pets dieser Stufe auszublenden.")</p>
                                    <p>@UiText.T("Nicht freigeschaltete Pets bleiben im Stufenfilter enthalten. Die Ebenenschalter und der Exklusivfilter bestimmen weiterhin, welche Pets wo erscheinen.")</p>
                                </InfoTip>
                            </div>
                            <div class="pet-level-options" role="group" aria-label="@UiText.T("Angezeigte Pet-Stufen")">
                                <label class="chip pet-level-option"><input type="checkbox" aria-label="@UiText.T("Stufe 1 anzeigen")" checked="@(!Settings.Current.HideLevel1)" @onchange="@(e => SetPetLevelVisible(1, (bool)e.Value!))" /> @UiText.T("Stufe 1")</label>
                                <label class="chip pet-level-option"><input type="checkbox" aria-label="@UiText.T("Stufe 2 anzeigen")" checked="@(!Settings.Current.HideLevel2)" @onchange="@(e => SetPetLevelVisible(2, (bool)e.Value!))" /> @UiText.T("Stufe 2")</label>
                                <label class="chip pet-level-option" title="@UiText.T("Stufe 3 (MAX) anzeigen")"><input type="checkbox" aria-label="@UiText.T("Stufe 3 (MAX) anzeigen")" checked="@(!Settings.Current.HideLevel3)" @onchange="@(e => SetPetLevelVisible(3, (bool)e.Value!))" /> @UiText.T("MAX")</label>
                            </div>
                            <div class="pet-level-included"><span>@UiText.T("Nicht freigeschaltet")</span><span>@UiText.T("immer enthalten")</span></div>
                            <label class="check pet-exclusive-option @(Settings.Current.ExclusivePetsOnly ? "is-active" : "")" title="@UiText.F("Nur Pets, deren Spawns und Quellmonster ausschließlich auf {0} vorkommen", MapLabel)"><input id="map-exclusive-only" type="checkbox" checked="@Settings.Current.ExclusivePetsOnly" @onchange="@(e => SetExclusiveOnly((bool)e.Value!))" /><span>@UiText.T("Nur kartenexklusive Pets")</span>@if (Settings.Current.ExclusivePetsOnly) { <span class="pet-exclusive-active">@UiText.T("Aktiv")</span> }</label>
                        </div>
                    }
                    @if (_open.Contains(group.Name))
                    {
                        <div class="cats">
                            @foreach (var cat in group.Categories)
                            {
                                <div class="cat legend-row" title="@CategoryLabel(cat)">
                                    <div class="legend-name">
                                        @if (group.Name == "Pets" && PetGenusIcons.IconUrl(cat.Name) is { } legendGenusIcon) { <img class="pet-genus-icon" src="@legendGenusIcon" alt="" /> }
                                        else if (cat.Icon is not null) { <img src="@cat.Icon" alt="" /> }
                                        else { <span class="dot" style="background:@cat.Color"></span> }
                                        <span class="label">@CategoryLabel(cat)</span>
                                        @if (group.Name == "Collectibles" && cat.Name == "Cube Groups")
                                        {
                                            <CubeGroupsInfo />
                                        }
                                        <span class="count">@cat.Count</span>
                                    </div>
                                    @foreach (var surface in LegendSurfaces)
                                    {
                                        <label class="legend-choice" title="@SurfaceLabel(surface)"><input type="checkbox" aria-label="@UiText.F("{0} auf {1} anzeigen", CategoryLabel(cat), SurfaceLabel(surface))" checked="@CategoryVisible(group, cat, surface)" @onchange="@(e => SetSurfaceCategory(group, cat, surface, (bool)e.Value!))" /></label>
                                    }
                                </div>
                                @foreach (var kind in cat.Kinds ?? [])
                                {
                                    var label = Settings.Current.NameLanguage == "de" ? kind.De ?? kind.Name : kind.Name;
                                    <div class="cat kind legend-row" title="@label">
                                        <div class="legend-name">@if (kind.Icon is not null) { <img src="@kind.Icon" alt="" /> }<span class="label">@label</span><span class="count">@kind.Count</span></div>
                                        @foreach (var surface in LegendSurfaces)
                                        {
                                            <label class="legend-choice" title="@SurfaceLabel(surface)"><input type="checkbox" aria-label="@UiText.F("{0} auf {1} anzeigen", label, SurfaceLabel(surface))" checked="@KindVisible(group, cat, kind.Name, surface)" @onchange="@(e => SetSurfaceKind(group, cat, kind.Name, surface, (bool)e.Value!))" /></label>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </aside>
    <div class="mapwrap">
        @if (Ui.ExclusivePetFilterNoticeVisible)
        {
            <div id="map-exclusive-notice" class="map-exclusive-notice" role="status">
                <span>@UiText.T("Exklusivfilter aktiv: Pets mit Fundorten auf mehreren Karten sind ausgeblendet.")</span>
                <button id="dismiss-map-exclusive-notice" type="button" title="@UiText.T("Filterhinweis schließen")" aria-label="@UiText.T("Filterhinweis schließen")" @onclick="DismissExclusivePetFilterNotice">×</button>
            </div>
        }
        <div class="mapcanvas">
        <div id="map"></div>
        <button type="button" class="side-toggle" title="@(_sideCollapsed ? UiText.T("Ebenen einblenden") : UiText.T("Ebenen ausblenden"))" aria-expanded="@(_sideCollapsed ? "false" : "true")" @onclick="ToggleSidebar">@(_sideCollapsed ? "›" : "‹")</button>
        <button type="button" class="side-toggle right" title="@(_rightCollapsed ? UiText.T("Tracking, Wegführung und Ziele einblenden") : UiText.T("Tracking, Wegführung und Ziele ausblenden"))" aria-expanded="@(_rightCollapsed ? "false" : "true")" @onclick="ToggleRightSidebar">@(_rightCollapsed ? "‹" : "›")</button>
        </div>
    </div>
    <aside class="sidebar mapside mapside-right">
        <h3>Tracking</h3>
        @* Player and loot tracker share one tile: two short parts instead of two framed cards. *@
        <div class="tile">
            <div class="tile-part">
            <div class="tile-head">
                <span class="tile-title">Player-Tracker</span>
                <span class="tile-state @(Tracking.Running ? (Tracking.NetworkSuspended || Tracking.Paused ? "rest" : Tracking.Found ? "on" : "warn") : "")" title="@UiText.T(Tracking.Status)">
                    @(Tracking.Running ? (Tracking.NetworkSuspended || Tracking.Paused ? UiText.T("◐ ruht") : Tracking.Found ? $"● {MapLabelOf(Tracking.Position?.MapId ?? _mapId)} · {Tracking.Fps} fps" : UiText.T("● sucht …")) : UiText.T("○ aus"))
                </span>
                @if (Tracking.Running)
                {
                    <button type="button" class="mapbtn stop" title="@UiText.T("Player-Tracker stoppen")" @onclick="Tracking.Stop">■</button>
                }
                else
                {
                    <button type="button" class="mapbtn play" title="@(Tracking.Region is null ? UiText.T("Zuerst unter Optionen den Kartenbereich markieren") : UiText.T("Player-Tracker starten"))" disabled="@(Tracking.Region is null)" @onclick="Tracking.Start">▶</button>
                }
            </div>
            @if (!Tracking.Running && Tracking.Region is null)
            {
                <div class="tile-hint">@UiText.T("Zuerst unter Optionen den Kartenbereich markieren.") <button type="button" class="btn link" @onclick="@(() => Ui.Navigate("options"))">@UiText.T("Optionen öffnen")</button></div>
            }
            <div class="row">
                <label class="check"><input type="checkbox" checked="@Settings.Current.FollowPlayer" @onchange="ToggleFollow" /> @UiText.T("Spieler verfolgen")</label>
                <label class="check" title="@UiText.T("Ohne verfügbare Netzwerk-Ortserkennung werden Instanzen anhand der fehlenden Karte vermutet. Mit verfügbarer Netzwerk-Ortserkennung ruht die Kartenerkennung in bestätigten Instanzen automatisch.")"><input type="checkbox" checked="@Settings.Current.PauseTrackingInInstances" id="pause-tracking-in-instances" disabled="@(!Tracking.UsesVisualFallback)" @onchange="@(e => Settings.Update(s => s.PauseTrackingInInstances = (bool)e.Value!))" /> @UiText.T("Bei visueller Erkennung in Instanzen ruhen")</label>
                @if (Tracking.Position is not null)
                {
                    <button type="button" class="btn link push" @onclick="CenterOnPlayer">@UiText.T("⌖ Zum Spieler")</button>
                }
            </div>
            @if (Tracking.StatusIsError)
            {
                <div class="status error">@UiText.T(Tracking.Status)</div>
            }
            </div>
            <div class="tile-part map-network-tracking">
            <div class="tile-head">
                <span class="tile-title">@UiText.T("Netzwerk-Tracking")</span>
                <span class="tile-state @(Loot.Running ? "on" : "")" title="@UiText.T(Loot.Status)">@(Loot.Running ? UiText.T("● Netzwerk") : UiText.T("○ aus"))</span>
                @if (Loot.Running)
                {
                    <button type="button" class="mapbtn stop" title="@UiText.T("Netzwerk-Tracking stoppen")" @onclick="Loot.Stop">■</button>
                }
                else
                {
                    <button type="button" class="mapbtn play" title="@UiText.T("Netzwerk-Tracking starten")" @onclick="@(() => Loot.Start())">▶</button>
                }
            </div>
            @if (_locationSource is { WorldContext.HasLocationFacts: true })
            {
                <WorldLocationStatus Snapshot="_locationSource.WorldContext.Snapshot" Enabled="Settings.Current.LootTrackingEnabled" />
            }
            @{ var recent = Progress.Recent().Take(3).ToList(); }
            @if (recent.Count > 0)
            {
                <div class="tile-lines">
                    @foreach (var soul in recent)
                    {
                        <div class="tile-line">+@soul.Quantity <b>@(Progress.Catalog.Find(soul.PetId)?.DisplayName(Settings.Current.NameLanguage) ?? soul.PetId)</b> <small>@soul.At.ToLocalTime().ToString("HH:mm")</small></div>
                    }
                </div>
            }
            else if (Loot.Running)
            {
                <div class="tile-line empty">@UiText.T("Noch keine Souls in dieser Sitzung.")</div>
            }
            @if (Loot.StatusIsError)
            {
                <div class="status error">@UiText.T(Loot.Status)</div>
            }
            </div>
        </div>

        <MapTimers />

        <h3>@UiText.T("Wegführung")</h3>
        <div class="tile boss-rush-tile">
            <div class="tile-head">
                <label class="tile-title switch" for="boss-rush-toggle" title="@UiText.T("Boss Rush ein- oder ausschalten")">
                    <input id="boss-rush-toggle" type="checkbox" role="switch" aria-label="@UiText.T("Boss Rush ein- oder ausschalten")" checked="@Settings.Current.BossRushEnabled" @onchange="ToggleBossRush" />
                    <span class="switch-track" aria-hidden="true"></span>
                    Boss Rush Mode
                </label>
                <InfoTip>@UiText.T("Boss Rush schaltet Wegführung und Spawn-Overlay gemeinsam. Aktivierte Boss-Alerts bleiben unabhängig davon eingeschaltet.")</InfoTip>
            </div>
            <label class="check" for="boss-rush-show-older-spawns"><input id="boss-rush-show-older-spawns" type="checkbox" checked="@Settings.Current.BossRushShowOlderSpawns" @onchange="ToggleOlderBossSpawns" /> @UiText.T("Gespawnte Bosse älter als 1 Min. anzeigen")</label>
            <button type="button" class="btn small" @onclick="@(() => Ui.Navigate("bossrush"))">@UiText.T("Boss-Rush-Tab öffnen")</button>
        </div>
        <div class="tile">
            <div class="tile-head">
                <label class="tile-title switch" title="@UiText.T("Progressionsmodus ein- oder ausschalten")">
                    <input type="checkbox" role="switch" checked="@Settings.Current.ProgressionEnabled" @onchange="ToggleProgression" />
                    <span class="switch-track" aria-hidden="true"></span>
                    @UiText.T("Progressionsmodus")
                </label>
                <InfoTip>
                    <p>@UiText.T("Führt zum nächsten offenen Ziel auf dieser Karte. Ohne Spielerposition zählt die Kartenmitte.")</p>
                    <p>@UiText.T("Mehrere Ziele: Das nächstgelegene offene Ziel kommt zuerst.")</p>
                    <p>@UiText.T("Führt zum Pet, dem die wenigsten Souls zur vollen Stufe fehlen; bei Gleichstand zum nächstgelegenen.")</p>
                    <p>@UiText.T("Höchste Mob-Dichte zuerst: Wählt das passende Pet mit den meisten Monster-Spawnpunkten auf dieser Karte. Die Wegführung führt zu seinem Pet-Symbol mit den meisten zugehörigen Spawns im Umkreis von 200 Metern. Ohne Pet-Symbol werden die Monster-Spawns als Zielpunkte geprüft.")</p>
                    <p>@UiText.T("Bei gleicher Gesamtzahl entscheiden gegebenenfalls die fehlenden Souls und danach die Entfernung zum dichtesten Bereich. Gleich dichte Bereiche werden nach Entfernung gewählt. Nähere Dungeons und Strongholds bleiben vorrangig.")</p>
                    <p>@UiText.T("Die Wegführung verändert keinen Dungeon- oder Garnisonsfortschritt. Netzwerkdaten und manuelle Korrekturen werden in der Erkundungsübersicht verwaltet; unbestätigte Netzwerkzustände bleiben unbestätigt.")</p>
                </InfoTip>
            </div>
            <div class="tile-field progression-kinds" role="group" aria-label="@UiText.T("Progressionsziele")">
                @foreach (var (kind, label) in ProgressionKindLabels)
                {
                    <label class="chip-check"><input type="checkbox" checked="@Settings.Current.ProgressionIncludes(kind)" @onchange="@(e => SetProgressionKind(kind, (bool)e.Value!))" /> @label</label>
                }
            </div>
            @if (Settings.Current.ProgressionKinds.Length == 0) {
                <div class="note">@UiText.T("Mindestens ein Ziel wählen.")</div>
            }
            @if (PetMode) {
            <div class="progression-genus-field">
                <span class="field-label">@UiText.T("Pet-Gattungen")</span>
                <div class="progression-genera" role="group" aria-label="@UiText.T("Pet-Gattungen für die Progression")">
                    @foreach (var (genus, label) in ProgressionGenusLabels)
                    {
                        <label class="chip-check"><input id="@("progression-genus-" + genus)" type="checkbox" checked="@Settings.Current.ProgressionIncludesGenus(genus)" @onchange="@(e => SetProgressionPetGenus(genus, (bool)e.Value!))" />@if (PetGenusIcons.IconUrl(genus) is { } progressionGenusIcon) { <img class="pet-genus-icon" src="@progressionGenusIcon" alt="" /> }<span>@label</span></label>
                    }
                </div>
            </div>
            @if (Settings.Current.ProgressionPetGenera.Length == 0)
            {
                <div class="note progression-genera-empty" role="status">@UiText.T("Keine Pet-Gattung ausgewählt – Pet-Ziele pausieren.")</div>
            }
            <div class="tile-field">
                <span class="field-label">@UiText.T("Ziel je Pet")</span>
                <select value="@(Settings.Current.ProgressionPetsClosest ? "closest" : Settings.Current.ProgressionGoal.ToString())" @onchange="SetProgressionGoal">
                    <option value="5">@UiText.T("5 Souls · freigeschaltet")</option>
                    <option value="30">@UiText.T("30 Souls · Stufe 2")</option>
                    <option value="105">@UiText.T("105 Souls · max")</option>
                    <option value="closest">@UiText.T("Am nächsten an der vollen Stufe")</option>
                </select>
            </div>
            <div class="tile-field progression-kinds">
                <label class="chip-check" for="progression-highest-density"><input id="progression-highest-density" type="checkbox" checked="@Settings.Current.ProgressionPetsHighestDensity" @onchange="SetProgressionHighestDensity" /> @UiText.T("Höchste Mob-Dichte zuerst")</label>
            </div>
            }
            @if (ExplorationMode) {
                <CharacterPicker />
            }
            @if (Settings.Current.ProgressionEnabled)
            {
                @if (Targets.Progression is { } next)
                {
                    <div class="targetlist">
                        <div class="target"><span class="swatch" style="background:#fff"></span>
                            <span class="name" title="@next.Kind" @onclick="FlyToProgression">@UiText.T("Nächstes:") <b>@next.Name</b> <small>· @next.Kind</small></span>
                        </div>
                    </div>
                }
                else if (!PetMode || Settings.Current.ProgressionPetGenera.Length > 0 || ExplorationMode)
                {
                    <div class="note">@(PetMode && !ExplorationMode
                        ? UiText.F("Keine offenen Pet-Ziele für die gewählten Gattungen auf {0}.", MapLabel)
                        : UiText.T("Keine offenen Ziele auf dieser Karte."))</div>
                }
            }
        </div>
        <div class="tile routes-tile">
            <div class="routes-heading">
                <span class="tile-title">@UiText.T("Routen")</span>
                <span class="routes-count">@Targets.Routes.Count</span>
            </div>
            <div class="route-character">
                <label for="route-character-profile">@UiText.T("Charakter")</label>
                <select id="route-character-profile" value="@Exploration.ActiveId" @onchange="@(e => Exploration.Select(e.Value!.ToString()!))">
                    @foreach (var character in Exploration.Characters)
                    {
                        <option value="@character.Id">@character.Name</option>
                    }
                </select>
                <details class="route-profile-tools">
                    <summary>@UiText.T("Profil verwalten")</summary>
                    <div class="route-profile-editor">
                        <input type="text" autocomplete="off" spellcheck="false" maxlength="80" aria-label="@UiText.T("Charaktername / Server")" placeholder="@UiText.T("Charaktername / Server")" @bind="_characterName" />
                        <button type="button" class="btn small" disabled="@(string.IsNullOrWhiteSpace(_characterName))" @onclick="AddRouteCharacter">@UiText.T("Profil anlegen")</button>
                        <button type="button" class="btn small" disabled="@(string.IsNullOrWhiteSpace(_characterName))" @onclick="RenameRouteCharacter">@UiText.T("Umbenennen")</button>
                    </div>
                </details>
            </div>

            <div class="route-overlay-settings"><OverlaySettingsLink OverlayId="leveling" /></div>

            @if (ActiveLevelingRoute is { } currentRoute && Targets.GetRouteProgress(currentRoute.Id) is { } currentProgress)
            {
                var nextObjective = Targets.VisibleTargets.FirstOrDefault(t => t.RouteId == currentRoute.Id && !t.Completed);
                var objectiveColor = nextObjective?.Color ?? LevelingRouteStyle.MainQuest;
                <section class="route-active" style="--objective-color:@objectiveColor" aria-label="@UiText.T("Aktive Leveling-Route")">
                    <div class="route-active-caption">
                        <span>@UiText.T("Aktive Leveling-Route")</span>
                        <span class="route-live-dot" aria-hidden="true"></span>
                    </div>
                    <h4>@currentRoute.Name</h4>
                    <div class="route-progress-copy">
                        <strong>@(currentProgress.CanGoNext ? UiText.F("Station {0} / {1}", currentProgress.Completed + 1, currentProgress.Total) : UiText.T("Route abgeschlossen"))</strong>
                        <span>@UiText.F("{0} %", RoutePercent(currentProgress))</span>
                    </div>
                    <div class="route-progress" role="progressbar" aria-label="@UiText.T("Routenfortschritt")" aria-valuemin="0" aria-valuemax="@currentProgress.Total" aria-valuenow="@currentProgress.Completed">
                        <span style="width:@(RoutePercent(currentProgress))%"></span>
                    </div>
                    @if (nextObjective is not null)
                    {
                        <button type="button" class="route-current-objective" title="@UiText.T("Ziel auf Karte zeigen")" @onclick="@(() => FlyToTarget(nextObjective))">
                            <span>@UiText.T("Aktuelles Ziel")</span>
                            <strong>@TargetLabel(nextObjective)</strong>
                        </button>
                    }
                    <div class="leveling-navigation">
                        <button type="button" class="btn" title="@UiText.T("Vorheriges Ziel")" disabled="@(!currentProgress.CanGoBack)" @onclick="@(() => Targets.RewindRoute(currentRoute.Id))">‹ @UiText.T("Zurück")</button>
                        <button type="button" class="btn route-next" title="@UiText.T("Nächstes Ziel")" disabled="@(!currentProgress.CanGoNext)" @onclick="@(() => Targets.AdvanceRoute(currentRoute.Id))">@UiText.T("Weiter") ›</button>
                    </div>
                    <ol class="route-stops" aria-label="@UiText.T("Stationen der aktiven Route")">
                        @foreach (var (target, index) in Targets.VisibleTargets.Where(t => t.RouteId == currentRoute.Id).Select((t, i) => (t, i)))
                        {
                            var isCurrent = target.Id == nextObjective?.Id;
                            <li class="route-stop @(target.Completed ? "completed" : "upcoming") @(isCurrent ? "current" : "")" style="--stop-color:@MapTargetsService.ColorOf(target, index)" aria-current="@(isCurrent ? "step" : null)">
                                <span class="route-stop-number">@((target.StopIndex ?? index) + 1)</span>
                                <button type="button" class="route-stop-title" title="@UiText.T("Ziel auf Karte zeigen")" @onclick="@(() => FlyToTarget(target))">@TargetLabel(target)</button>
                                @if (!target.Completed && !isCurrent)
                                {
                                    <button type="button" class="route-stop-skip" title="@UiText.T("Bis zu diesem Ziel vorspringen")" aria-label="@UiText.F("Bis Station {0} vorspringen", (target.StopIndex ?? index) + 1)" @onclick="@(() => Targets.Remove(target.Id))">›</button>
                                }
                            </li>
                        }
                    </ol>
                    <div class="route-save-state">@UiText.T("Fortschritt für diesen Charakter gespeichert")</div>
                    <button type="button" class="btn route-cancel" title="@UiText.T("Route beenden und Fortschritt behalten")" @onclick="@(() => Targets.StopRoute(currentRoute.Id))"><span aria-hidden="true">■</span> @UiText.T("Route abbrechen")</button>
                    @if (!LevelingRouteStyle.TryGetEpisode(currentRoute, out _, out _))
                    {
                        @RepeatControl(currentRoute)
                    }
                    <details class="route-active-options">
                        <summary>@UiText.T("Routenoptionen")</summary>
                        <button type="button" class="btn small" @onclick="@(() => RestartRoute(currentRoute))">↺ @UiText.T("Von vorne starten")</button>
                    </details>
                </section>
            }

            @{ var markedTargets = Targets.VisibleTargets.Where(t => !t.Leveling).ToArray(); }
            @if (markedTargets.Length > 0 || ActiveLevelingRoute is null)
            {
                <section class="route-marked">
                    <div class="route-section-heading">
                        <span>@UiText.T("Markierte Ziele")</span>
                        <span class="routes-count">@markedTargets.Length</span>
                        @if (markedTargets.Length > 0)
                        {
                            <button type="button" class="btn link" @onclick="Targets.Clear">@UiText.T("Alle entfernen")</button>
                        }
                    </div>
                    @foreach (var route in Targets.Routes.Where(r => !r.IsLeveling && markedTargets.Any(t => t.RouteId == r.Id)))
                    {
                        <div class="route-marked-running" data-running-route="@route.Id" @key="route.Id" style="--route-color:@route.Color">
                            <div><span>@UiText.T("Laufende Route")</span><strong>@route.Name</strong></div>
                            @RepeatControl(route)
                        </div>
                    }
                    @if (markedTargets.Length == 0)
                    {
                        <div class="route-empty">@UiText.T("Route aus der Bibliothek starten oder Ziele per Rechtsklick auf der Karte markieren.")</div>
                    }
                    else
                    {
                        <div class="targetlist route-marked-list route-marked-preview">
                            @MarkedTargetRows(markedTargets.Take(3), 0)
                        </div>
                        @if (markedTargets.Length > 3)
                        {
                            <details class="route-marked-more">
                                <summary><span class="route-more-closed">@UiText.F("Weitere {0} Ziele", markedTargets.Length - 3)</span><span class="route-more-open">@UiText.T("Weniger anzeigen")</span></summary>
                                <div class="targetlist route-marked-list route-marked-overflow" tabindex="0" role="region" aria-label="@UiText.T("Weitere markierte Ziele")">
                                    @MarkedTargetRows(markedTargets.Skip(3), 3)
                                </div>
                            </details>
                        }
                    }
                    @if (!Targets.Targets.Any(t => t.Leveling) && Targets.ChainOn(_mapId) is { Count: >= 2 } chain)
                    {
                        <div class="tile-field route-save">
                            <span class="swatch" style="background:@Targets.NextRouteColor" title="@UiText.T("Farbe der neuen Route; danach in der Liste änderbar")"></span>
                            <input type="text" maxlength="60" autocomplete="off" spellcheck="false" aria-label="@UiText.T("Name der Route")" placeholder="@($"{chain[0].Name} → {chain[^1].Name}")" @bind="_routeName" />
                            <button type="button" class="btn small" @onclick="SaveRoute">@UiText.F("Folge speichern ({0})", chain.Count)</button>
                        </div>
                    }
                </section>
            }

            <div class="route-library">
                <div class="route-section-heading"><span>@UiText.T("Bibliothek")</span><span class="routes-count">@Targets.Routes.Count</span></div>
                @if (Targets.Routes.Count == 0)
                {
                    <div class="route-empty">@UiText.T("Markiere mit Shift+Rechtsklick eine Folge aus mindestens zwei Zielen, dann kannst du sie hier als Route speichern.")</div>
                }
                else
                {
                    <input class="search route-search" type="search" autocomplete="off" spellcheck="false" aria-label="@UiText.T("Routen suchen")" placeholder="@UiText.T("Routen suchen …")" @bind="_routeQuery" @bind:event="oninput" />
                    <div class="route-library-groups">
                        @foreach (var category in FilteredRoutes.GroupBy(r => r.Category ?? UiText.T("Eigene Routen")))
                        {
                            <details class="route-group" @key="(category.Key, _routeQuery)" open="@(category.Key == LevelingRouteStyle.Category || ActiveLevelingRoute is null || !string.IsNullOrWhiteSpace(_routeQuery))">
                                <summary><span>@category.Key</span><span class="routes-count">@category.Count()</span></summary>
                                @if (category.Key == LevelingRouteStyle.Category)
                                {
                                    <div class="route-faction-groups">
                                        @foreach (var faction in category.Where(r => RouteFaction(r) is not null).GroupBy(r => RouteFaction(r)!).OrderBy(g => g.Key, StringComparer.Ordinal))
                                        {
                                            var factionProgress = FactionProgress(faction);
                                            <details class="route-faction-group" data-faction="@faction.Key" @key="(category.Key, faction.Key, _routeQuery)" open="@(!string.IsNullOrWhiteSpace(_routeQuery) || faction.Any(r => r.Id == Targets.ActiveLevelingRouteId))">
                                                <summary>
                                                    <span class="route-faction-label"><strong>@faction.Key</strong><small>@faction.Count() @UiText.T("Routen")</small></span>
                                                    <span class="route-faction-percent">@UiText.F("{0} %", RoutePercent(factionProgress))</span>
                                                </summary>
                                                <div class="route-faction-body">
                                                    <div class="route-card-progress"><span>@UiText.F("{0} / {1} erledigt", factionProgress.Completed, factionProgress.Total)</span></div>
                                                    <div class="route-progress compact" aria-hidden="true"><span style="width:@(RoutePercent(factionProgress))%"></span></div>
                                                    @RouteCards(faction)
                                                </div>
                                            </details>
                                        }
                                        @if (category.Where(r => RouteFaction(r) is null).ToArray() is { Length: > 0 } unassigned)
                                        {
                                            <div class="route-unassigned">
                                                <div class="note">@UiText.T("Weitere Leveling-Routen")</div>
                                                @RouteCards(unassigned)
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    @RouteCards(category)
                                }
                            </details>
                        }
                        @if (!FilteredRoutes.Any())
                        {
                            <div class="route-empty">@UiText.T("Keine passenden Routen.")</div>
                        }
                    </div>
                }
            </div>
            @if (_routeStatus is not null)
            {
                <div class="route-status" role="status">@_routeStatus</div>
            }
            <details class="route-settings">
                <summary>@UiText.T("Darstellung & Ankunft")</summary>
                <div class="route-objective-legend" aria-label="@UiText.T("Farben nach Objective")">
                    <span><i style="background:#facc15"></i>@UiText.T("Hauptquest")</span>
                    <span><i style="background:#a78bfa"></i>Kibelisk / Teleport</span>
                    <span><i style="background:#ffffff"></i>Dungeon / Stronghold</span>
                    <span><i style="background:#4ade80"></i>@UiText.T("Regionalquest")</span>
                </div>
                <label class="tile-field route-radius">
                    <span>@UiText.T("Ankunftsradius (Kartenpixel)")</span>
                    <input type="number" min="0" max="500" step="5" value="@Settings.Current.TargetArrivalRadius" @onchange="SetArrivalRadius" />
                </label>
                <InfoTip>
                    <p>@UiText.T("Leveling-Routen zeigen die letzten 3 Stationen verblasst und die nächsten 3 farbig.")</p>
                    <p>@UiText.T("Am Ende startet die nächste Episode automatisch.")</p>
                    <p>@UiText.T("Bei Ankunft an einem markierten Wegpunkt oder einer Leveling-Station geht es automatisch weiter. 0 deaktiviert das automatische Weiterschalten.")</p>
                    <p>@UiText.T("Shift+Rechtsklick hängt ein Ziel an die markierte Folge an.")</p>
                </InfoTip>
            </details>
        </div>



    </aside>
</div>

@code {
    private const string BaseUrl = "https://" + MainForm.MapDataHost + "/";
    [Parameter] public bool Active { get; set; }

    private sealed record MapDef(string Id, string Label, string Group);
    private string CategoryLabel(Category category) => Settings.Current.NameLanguage == "de" ? category.De ?? category.Name : category.Name;
    private sealed record Category(int Index, string Name, int Count, bool Hidden, string Color, string? Icon, string? De = null, List<Kind>? Kinds = null);
    /// <summary>Resource kind of a category (Gem: Sapphire, Diamond, Ruby), with its item icon.</summary>
    private sealed record Kind(string Name, string? De, string? Icon, int Count);
    // Hidden resource kinds of the shown map, keys as MapPetMarkers.KindKey.
    private readonly HashSet<string> _hiddenKinds = [];
    private static string KindKey(Group group, Category cat, string kind) => MapPetMarkers.KindKey(MapPetMarkers.CategoryKey(group.Name, cat.Name), kind);
    private sealed record Group(string Name, List<Category> Categories);
    private sealed record ShowResult(List<Group> Groups, int Regions, int Markers, bool Cancelled = false);
    private sealed record SearchHit(int I, string Name, string Cat, bool Monster = false, string? Key = null, string? Group = null, string? PetId = null);
    private sealed record PetFocusCount(int Pets, int Monsters);

    private static readonly JsonSerializerOptions Json = new() { PropertyNameCaseInsensitive = true };
    private readonly List<MapDef> _maps = [];
    private List<Group> _groups = [];
    private readonly HashSet<int> _visible = [];
    private readonly HashSet<string> _open = ["Pets", "Locations"];
    private List<SearchHit> _results = [];
    private MapMonsterSearch? _monsterSearch;
    private Dictionary<string, MonsterSearchMatch> _monsterResults = new(StringComparer.Ordinal);
    private MonsterSearchMatch? _monsterFocus;
    private bool _searchBusy;
    private long _searchRevision;
    private IReadOnlyList<MapInfo> MonsterFarmMaps => _monsterFocus is { } monster && _monsterSearch is not null ? _monsterSearch.FarmMaps(monster) : [];
    private DotNetObjectReference<MapView>? _self;
    private string _mapId = "altgard";
    private string _query = "";
    private string? _focus;
    private int _focusPets, _focusMonsters, _markerCount;
    private bool _ready, _wasActive;
    private bool _sideCollapsed, _rightCollapsed, _relayout; // view-only: sidebars hidden for small windows
    private string? _error;
    private LootTrackerMapFocus? _lootRouteFocus;
    private bool _lootShowKills = true, _lootShowDeaths = true, _lootShowOdyle = true;

    private string MapLabel => UiText.T(_maps.FirstOrDefault(m => m.Id == _mapId)?.Label ?? _mapId);

    protected override void OnInitialized()
    {
        Ui.ObserveExclusivePetFilter(Settings.Current.ExclusivePetsOnly);
        _maps.AddRange(Progress.Maps.Select(m => new MapDef(m.Id, m.Label, m.Group)));
        if (Progress.MapDataDirectory is { } directory)
            _monsterSearch = new MapMonsterSearch(directory, Progress.Maps, Progress.Catalog);
        _mapId = _maps.Any(m => m.Id == Settings.Current.LastMap) ? Settings.Current.LastMap : _maps.First().Id;
        _bossRush = Services.GetService(typeof(BossRushService)) as BossRushService;
        if (_bossRush is not null) _bossRush.Changed += OnBossTimersChanged;
        _locationSource = Services.GetService(typeof(Soulcrest.App.Network.NetworkLootService)) as Soulcrest.App.Network.NetworkLootService;
        if (_locationSource is not null) _locationSource.WorldContext.Changed += OnWorldLocationChanged;
        Progress.Changed += OnProgressChanged;
        Exploration.Changed += OnExplorationChanged;
        Tracking.Changed += OnTrackingChanged;
        Targets.Changed += OnTargetsChanged;
        Loot.Changed += OnLootChanged;
        _language = Settings.Current.UiLanguage;
        _nameLanguage = Settings.Current.NameLanguage;
        _networkFollowEnabled = Settings.Current.FollowPlayer;
        _networkProgressionEnabled = Settings.Current.ProgressionEnabled;
        _networkSourceEnabled = Settings.Current.LootTrackingEnabled;
        if (ObserveNetworkMap() is { } initialMap)
        {
            _mapId = initialMap;
            if (Settings.Current.LastMap != initialMap) Settings.Update(s => s.LastMap = initialMap);
        }
        Settings.Changed += OnSettingsChanged;
    }

    private BossRushService? _bossRush;
    private Soulcrest.App.Network.NetworkLootService? _locationSource;
    private bool _disposed;
    private int _worldLocationQueued;
    private int? _observedNetworkMapDataId;
    private bool _networkFollowEnabled, _networkProgressionEnabled, _networkSourceEnabled;
    private void OnWorldLocationChanged()
    {
        if (_disposed || Interlocked.Exchange(ref _worldLocationQueued, 1) != 0) return;
        _ = InvokeAsync(async () =>
        {
            Volatile.Write(ref _worldLocationQueued, 0);
            if (_disposed) return;
            await FollowNetworkMap();
            if (!_disposed) StateHasChanged();
        });
    }

    // Network Own identifies the map before a visual position exists. A repeated Own or dungeon
    // refinement must not undo manual browsing; retain unsupported native IDs to notice a return.
    private string? ObserveNetworkMap(bool force = false)
    {
        if (!Settings.Current.LootTrackingEnabled || _locationSource?.WorldContext.Snapshot is not
            { Status: WorldContextStatus.Confirmed, MapDataId: > 0 } source) return null;
        var changed = _observedNetworkMapDataId != source.MapDataId;
        _observedNetworkMapDataId = source.MapDataId;
        if (EffectiveFeaturePolicy.TrackingMode(true, source) != MapTrackingMode.NetworkMap
            || source.SoulcrestMapId is not { } mapId || !_maps.Any(m => m.Id == mapId)) return null;
        if (changed || force) _trackedMap = mapId;
        return changed || force ? mapId : null;
    }

    private async Task FollowNetworkMap(bool force = false)
    {
        if (_disposed || ObserveNetworkMap(force) is not { } mapId || mapId == _mapId) return;
        if (Settings.Current.ProgressionEnabled) Targets.SetProgression(null);
        if (!_ready)
        {
            _mapId = mapId;
            Settings.Update(s => s.LastMap = mapId);
            return; // First render loads the latest selection after the JS map exists.
        }
        var player = ExplorationOverview.FreshPosition(ExplorationOverview.Capture(Tracking), DateTimeOffset.UtcNow);
        var centerOnPlayer = Settings.Current.FollowPlayer || Settings.Current.ProgressionEnabled;
        await SwitchMap(mapId, keepAt: centerOnPlayer && player?.MapId == mapId ? player : null);
    }
    private void OnBossTimersChanged() => _ = InvokeAsync(async () => { if (_ready) await PushBossTimers(); });
    private async Task PushBossTimers()
    {
        var rows = _bossRush?.Schedule.Where(row => row.Place.Map == _mapId).Select(row => new {
            spawnId = row.Place.Boss.SpawnId, spawned = row.Spawned, remaining = row.Remaining.TotalSeconds,
            age = row.Age.TotalSeconds, cached = row.Cached, calendar = row.Calendar, spawnElapsed = row.SpawnElapsed?.TotalSeconds
        }).ToArray();
        await JS.InvokeVoidAsync("soulcrestMap.setBossTimers", _mapId, JsonSerializer.Serialize(rows ?? []), Settings.Current.BossRushShowOlderSpawns);
    }

    private string? _language, _nameLanguage;
    private void OnSettingsChanged()
    {
        var languageChanged = _language != Settings.Current.UiLanguage || _nameLanguage != Settings.Current.NameLanguage;
        _language = Settings.Current.UiLanguage;
        _nameLanguage = Settings.Current.NameLanguage;
        var following = Settings.Current.FollowPlayer;
        var progressing = Settings.Current.ProgressionEnabled;
        var networkEnabled = Settings.Current.LootTrackingEnabled;
        var synchronizeMap = following && !_networkFollowEnabled || progressing && !_networkProgressionEnabled
            || networkEnabled && !_networkSourceEnabled;
        _networkFollowEnabled = following;
        _networkProgressionEnabled = progressing;
        _networkSourceEnabled = networkEnabled;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            _relayout |= Ui.ObserveExclusivePetFilter(Settings.Current.ExclusivePetsOnly);
            if (synchronizeMap) await FollowNetworkMap(force: true);
            if (languageChanged && _ready)
            {
                await PushDone();
                await JS.InvokeVoidAsync("soulcrestMap.setLanguage", Settings.Current.NameLanguage);
                await Search();
            }
            StateHasChanged();
        });
    }

    private DateTime _lastLootRender;

    private void OnLootChanged()
    {
        if (DateTime.Now - _lastLootRender < TimeSpan.FromMilliseconds(500))
            return;
        _lastLootRender = DateTime.Now;
        InvokeAsync(StateHasChanged);
    }


    private void ToggleBossRush(ChangeEventArgs e)
    {
        var enabled = (bool)e.Value!;
        Settings.Update(s => s.BossRushEnabled = enabled);
        if (enabled && !Loot.Running) Loot.Start();
    }

    private void ToggleOlderBossSpawns(ChangeEventArgs e) =>
        Settings.Update(s => s.BossRushShowOlderSpawns = e.Value is true);

    private async Task ToggleProgression(ChangeEventArgs e)
    {
        var enabled = (bool)e.Value!;
        Settings.Update(s => s.ProgressionEnabled = enabled);
        var player = ExplorationOverview.FreshPosition(ExplorationOverview.Capture(Tracking), DateTimeOffset.UtcNow);
        if (enabled && player is not null && player.MapId != _mapId && _maps.Any(m => m.Id == player.MapId))
        {
            // Enabling progression while browsing another map starts on the actual player map,
            // even when that map was already observed and ordinary player following is off.
            _trackedMap = player.MapId;
            Targets.SetProgression(null);
            await SwitchMap(player.MapId, keepAt: player);
            return;
        }
        await PushProgression();
    }

    private async Task SetProgressionGoal(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (value == "closest")
            Settings.Update(s => s.ProgressionPetsClosest = true);
        else if (int.TryParse(value, out var goal))
            Settings.Update(s => { s.ProgressionGoal = goal; s.ProgressionPetsClosest = false; });
        await PushProgression();
    }

    private async Task SetProgressionHighestDensity(ChangeEventArgs e)
    {
        Settings.Update(s => s.ProgressionPetsHighestDensity = (bool)e.Value!);
        await PushProgression();
    }

    private static readonly (string Genus, string Label)[] ProgressionGenusLabels =
        [("cogni", "Cogni"), ("natura", "Natura"), ("varian", "Varian"), ("fera", "Fera")];

    private bool ProgressionPetAllowed(string petId) => Progress.Catalog.Find(petId) is { } pet
        && Settings.Current.ProgressionIncludesGenus(pet.Genus);

    private async Task SetProgressionPetGenus(string genus, bool enabled)
    {
        Settings.Update(s => s.ProgressionPetGenera = enabled
            ? [.. s.ProgressionPetGenera.Append(genus)]
            : [.. s.ProgressionPetGenera.Where(value => value != genus)]);
        // Revoke the old target before awaiting JS, including while location-based navigation is suspended.
        if (Targets.Progression is { PetId: { } petId } && !ProgressionPetAllowed(petId))
            Targets.SetProgression(null);
        await PushProgression();
    }

    private static readonly (string Kind, string Label)[] ProgressionKindLabels =
        [("pets", "Pets"), ("dungeon", "Sealed Dungeons"), ("stronghold", "Strongholds")];

    private async Task SetProgressionKind(string kind, bool on)
    {
        Settings.Update(s => s.ProgressionKinds = on
            ? [.. s.ProgressionKinds.Append(kind).Distinct(StringComparer.Ordinal)]
            : [.. s.ProgressionKinds.Where(k => k != kind)]);
        await PushProgression();
    }

    private void SetArrivalRadius(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value)) Settings.Update(s => s.TargetArrivalRadius = Math.Clamp(value, 0, 500));
    }

    private bool PetMode => Settings.Current.ProgressionIncludes("pets");
    private bool ExplorationMode => Settings.Current.ProgressionIncludes("dungeon") || Settings.Current.ProgressionIncludes("stronghold");

    private async Task PushProgression()
    {
        var shownMap = _mapId;
        var revision = _mapPresentationRevision;
        bool Current() => !_disposed && shownMap == _mapId && revision == _mapPresentationRevision;
        if (Targets.Progression is { } previous && previous.MapId != shownMap)
        {
            Targets.SetProgression(null);
        }
        if (!Current()) return;
        var souls = Progress.Catalog.Pets.ToDictionary(p => p.Id, p => Progress.Souls(p.Id));
        // Souls still missing to finish each pet's current level (0 = max), for "closest to completion".
        var missing = souls.ToDictionary(p => p.Key, p => Math.Max(0, Progress.NeededForNextLevel(p.Key) - Progress.SoulsInLevel(p.Key)));
        // Source-monster placements on this exact map, not clustered pet-symbol counts or an Abyss region sum.
        var spawnCounts = Progress.Catalog.Pets.ToDictionary(p => p.Id, p => Math.Max(0, p.Monsters.GetValueOrDefault(shownMap)));
        var profile = Exploration.Snapshot();
        var done = profile.Completed;
        // locked/needs: sealed dungeons that open only after others (progression skips them, the popup names them).
        var places = Exploration.Places.Where(p => p.Map == shownMap).Select(p =>
        {
            var needs = Exploration.MissingFor(p, done);
            return new { index = p.Marker, id = p.Id, kind = p.Kind, done = done.Contains(p.Id),
                state = profile.Progress.GetValueOrDefault(p.Id)?.State?.ToString(), locked = needs.Count > 0,
                needs = needs.Select(n => n.Name(Settings.Current.NameLanguage)).ToArray() };
        });
        await JS.InvokeVoidAsync("soulcrestMap.setExploration", JsonSerializer.Serialize(places));
        if (!Current()) return;
        await PushNavigationContext();
        if (!Current()) return;
        var allowedPets = Progress.Catalog.Pets.Where(p => Settings.Current.ProgressionIncludesGenus(p.Genus))
            .Select(p => p.Id).ToHashSet(StringComparer.Ordinal);
        var allowedPetIds = allowedPets.Concat(Progress.Catalog.Aliases.Where(pair => allowedPets.Contains(pair.Value)).Select(pair => pair.Key));
        await JS.InvokeVoidAsync("soulcrestMap.setProgression", Settings.Current.ProgressionEnabled, Settings.Current.ProgressionGoal, JsonSerializer.Serialize(souls), JsonSerializer.Serialize(Settings.Current.ProgressionKinds), Settings.Current.ProgressionPetsClosest, profile.CharacterId, JsonSerializer.Serialize(missing), Settings.Current.ProgressionPetsHighestDensity, JsonSerializer.Serialize(spawnCounts), JsonSerializer.Serialize(allowedPetIds));
        if (Current() && !Settings.Current.ProgressionEnabled)
            Targets.SetProgression(null);
    }

    private async Task FlyToProgression() => await JS.InvokeVoidAsync("soulcrestMap.flyToProgression");

    [JSInvokable]
    public void OnProgressionTarget(string mapId, string? petId, double x, double y, string? name, long? contextGeneration = null)
    {
        // A callback can still be queued by the old map after ShowMap has replaced its payload.
        // Ignore it, including an old null target, rather than overwriting the new map's guidance.
        if (!Tracking.IsCurrentProgressionContext(contextGeneration)) return;
        if (!Tracking.CanSelectProgression(mapId)) return;
        if (mapId != _mapId || !_maps.Any(m => m.Id == mapId)) return;
        var player = ExplorationOverview.FreshPosition(ExplorationOverview.Capture(Tracking), DateTimeOffset.UtcNow);
        if (player is not null && player.MapId != mapId) return;
        if (petId is not null && (!double.IsFinite(x) || !double.IsFinite(y))) return;
        if (petId is null || !Settings.Current.ProgressionEnabled)
        {
            Tracking.TrySetProgression(Targets, null, mapId, contextGeneration);
            return;
        }
        var place = Exploration.Places.FirstOrDefault(p => p.Id == petId && p.Map == mapId);
        if (place is not null)
        {
            Tracking.TrySetProgression(Targets, new MapTarget("progression", mapId, x, y, place.Name(Settings.Current.NameLanguage), place.Kind == "dungeon" ? "Sealed Dungeon" : "Stronghold", null), mapId, contextGeneration);
            return;
        }
        var pet = Progress.Catalog.Find(petId);
        // A queued response from an older selection cannot restore an excluded pet.
        if (pet is null || !Settings.Current.ProgressionIncludesGenus(pet.Genus)) return;
        var label = $"{pet.DisplayName(Settings.Current.NameLanguage)} ({PetLabel(petId)})";
        Tracking.TrySetProgression(Targets, new MapTarget("progression", mapId, x, y, name ?? label, label, null, PetId: petId), mapId, contextGeneration);
    }

