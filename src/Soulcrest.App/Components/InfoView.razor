@implements IDisposable
@inject ProgressService Progress
@inject UpdateService Updates
@inject SettingsService Settings

<div class="page info">
    <header class="sv-head">
        <h2>Soulcrest – Tester 0.1</h2>
        <p class="sv-lead">@UiText.T("Aion-2-Pet-Begleiter: Offline-Karte, passiver Netzwerkfortschritt, Spieler-Tracking und Overlays. Netzwerk-Tracking startet automatisch und ist dauerhaft ausschaltbar.")</p>
    </header>

    <DiagnosticsPanel />

    <section class="card sv-card">
        <h3>@UiText.T("So testest du")</h3>
        <ol class="sv-steps">
            <li><b>@UiText.T("Netzwerkfortschritt"):</b> @UiText.T("Neue Pet-Souls zählen bei laufender Netzwerkquelle ohne Charakter- oder Serverauswahl in einer gemeinsamen Sammlung. Für den vollständigen Pet- und Erkundungsabgleich öffne einmal die Charakterauswahl und logge dich wieder ein. Erkundungsfortschritt bleibt an deinen Charakter gebunden.")</li>
            <li><b>Pets:</b> @UiText.T("Fortschritt eintragen, Fokus-Pets mit ★ markieren (erscheinen im Overlay). „Karte“ zeigt Spawns und Quellmonster.")</li>
            <li><b>@UiText.T("Netzwerk-Tracking"):</b> @UiText.T("Startet automatisch über Npcap. In den Optionen oder auf der Karte ausschaltbar; Ausschalten bleibt gespeichert.")</li>
        </ol>
    </section>

    <section class="card sv-card">
        <h3>@UiText.T("Tastenkürzel (global)")</h3>
        <dl class="info-keys">
            <dt>@UiText.T("Overlay-Hotkeys")</dt><dd>@UiText.T("In den Optionen pro Overlay frei belegbar.")</dd>
            <dt>@UiText.T("Schloss")</dt><dd>@UiText.T("Schloss im Overlay anklicken, um es zu bedienen und zu verschieben. Erneut klicken, um Klicks durchzulassen.")</dd>
        </dl>
    </section>

    <section class="card sv-card">
        <h3>@UiText.T("Daten und Speicherorte")</h3>
        <dl class="info-paths">
            <dt>@UiText.T("Kartendaten")</dt><dd><code class="sv-path">@(Progress.MapDataDirectory ?? UiText.T("nicht gefunden"))</code></dd>
            <dt>@UiText.T("Fortschritt, Einstellungen, Pins, Ereignisprotokoll")</dt><dd><code class="sv-path">@AppPaths.DataDirectory</code></dd>
        </dl>
    </section>

    <section class="card sv-card">
        <div class="sv-card-head">
            <h3>@UiText.T("Updates")</h3>
            <span class="sv-badge @(Updates.State switch { UpdateState.UpToDate => "ok", UpdateState.Available => "on", UpdateState.Failed => "error", _ => "" })">
                @UiText.F("installiert: {0}", UpdateService.Installed?.ToString() ?? AppPaths.Version)
            </span>
        </div>
        <p class="sv-hint">@UiText.T("Soulcrest fragt die Releases auf GitHub ab und zeigt neue Versionen mit ihren Patchnotes. Gesendet wird nur die Anfrage selbst.")</p>
        <div class="row">
            <button type="button" class="btn primary @(Updates.State == UpdateState.UpToDate && _checked ? "done" : "")" disabled="@(Updates.State is UpdateState.Checking or UpdateState.Downloading or UpdateState.Starting)" @onclick="CheckUpdates">
                @(Updates.State == UpdateState.Checking ? UiText.T("Suche …") : Updates.State == UpdateState.UpToDate && _checked ? UiText.T("✓ Aktuell") : UiText.T("Nach Updates suchen"))
            </button>
            @if (Updates.State == UpdateState.Available && Updates.Available.Count > 0)
            {
                <button type="button" class="btn" @onclick="ShowUpdate">@UiText.F("Version {0} ansehen", Updates.Available[0].Version)</button>
            }
            <span class="note">@(Updates.Message is { } message ? UiText.T(message) : "")@(Updates.CheckedAt is { } checkedAt ? " · " + checkedAt.ToString("HH:mm:ss") : "")</span>
        </div>
        <label class="opt-toggle"><input type="checkbox" checked="@Settings.Current.CheckUpdatesOnStart" @onchange="@(e => Settings.Update(s => s.CheckUpdatesOnStart = (bool)e.Value!))" /><span>@UiText.T("Beim Start nach Updates suchen")</span></label>
    </section>

    <section class="card sv-card info-support">
        <h3>@UiText.T("Soulcrest unterstützen")</h3>
        <p class="sv-hint">@UiText.T("Soulcrest ist kostenlos und bleibt es. Wer die Entwicklung unterstützen möchte, kann freiwillig über Ko-fi spenden.")</p>
        <div class="row">
            <a class="btn primary" href="https://ko-fi.com/newage57976" target="_blank" rel="noopener">☕ @UiText.T("Auf Ko-fi unterstützen")</a>
            <span class="note">ko-fi.com/newage57976</span>
        </div>
    </section>

    <section class="card sv-card">
        <h3>@UiText.T("Quellen und Lizenzen")</h3>
        <ul>
            @* Visible, clickable credit: condition of the data permission by gaming.tools (2026-10-06). *@
            <li>@UiText.T("Karten, Marker, Pet-Porträts und EN/DE-Namen:") <a href="https://aion2.gaming.tools/" target="_blank" rel="noopener">aion2.gaming.tools</a> @UiText.T("(mit Erlaubnis). Grafiken © NCSOFT.")</li>
            <li>@UiText.T("Soulcrest-Code: PolyForm Noncommercial 1.0.0 (nicht kommerziell nutzbar, siehe LICENSE.md).")</li>
            <li>Leaflet 1.9.4 (BSD-2-Clause).</li>
            <li>@UiText.T("Aion, Aion 2 und alle Spielinhalte © NCSOFT. Inoffizielles, privates Fanprojekt.")</li>
        </ul>
    </section>
</div>

@code {
    private bool _checked;

    protected override void OnInitialized()
    {
        Updates.Changed += Refresh;
    }

    private async Task CheckUpdates()
    {
        await Updates.CheckAsync();
        _checked = true;
    }

    private void ShowUpdate() => Updates.Reopen();

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Updates.Changed -= Refresh;
    }
}
