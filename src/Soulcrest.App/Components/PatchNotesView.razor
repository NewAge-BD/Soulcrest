<div class="page info patchnotes">
    <header class="sv-head">
        <h2>@UiText.T("Patchnotes")</h2>
        <p class="sv-lead">@UiText.T("Was sich in jeder Version geändert hat, die neueste oben.")</p>
    </header>

    @if (PatchNotes.Shown.Count == 0)
    {
        <div class="status error">@UiText.T("Patchnotes nicht gefunden.")</div>
    }
    @foreach (var release in PatchNotes.Shown)
    {
        var installed = release.Version == InstalledVersion;
        <section class="card sv-card pn-release @(installed ? "current" : "")">
            <div class="sv-card-head">
                <h3>@release.Version</h3>
                <span class="note">@release.Date</span>
                @if (installed)
                {
                    <span class="sv-badge on">@UiText.T("installiert")</span>
                }
            </div>
            <PatchNotesEntries Entries="@release.Entries" />
        </section>
    }
</div>

@code {
    // "0.1.28+a4b8137.tester…" -> "0.1.28"
    private static string InstalledVersion => AppPaths.Version.Split('+', 2)[0];

}
