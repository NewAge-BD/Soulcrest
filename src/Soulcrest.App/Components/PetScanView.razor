@implements IDisposable
@inject PetScanService Scan
@inject ProgressService Progress
@inject SettingsService Settings

<div class="page pet-scan-page">
    <header class="pet-scan-header">
        <div>
            <span class="pet-scan-eyebrow">@UiText.T("Serverweiter Fortschritt")</span>
            <h2>@UiText.T("Pet Scan")</h2>
            <p>@UiText.T("Pet-Fenster lesen, Ergebnisse prüfen und deinen Stand übernehmen.")</p>
        </div>
        <div class="pet-scan-saved-summary">
            <strong>@UiText.F("{0} freigeschaltet · {1} max", _savedUnlocked, _savedMax)</strong>
            <span>@UiText.T("In Soulcrest gespeichert · für alle Charaktere dieses Servers")</span>
        </div>
    </header>

    <section class="card pet-scan-workflow" aria-label="@UiText.T("Pet-Scan durchführen")">
        <div class="pet-scan-section-heading">
            <h3>@UiText.T("Pet-Fenster einlesen")</h3>
            <span class="pet-scan-state @(Scan.StatusIsError ? "error" : Scan.Running ? "live" : Scan.Starting || _readingFile ? "starting" : "")">
                <i aria-hidden="true"></i>@UiText.T(Scan.StatusIsError ? "Fehler beim Scan" : _readingFile ? "Bild wird gelesen …" : Scan.Starting ? "Scan startet …" : Scan.Running ? "Scan läuft" : "Bereit")
            </span>
        </div>
        <ol class="pet-scan-steps">
            <li><span>1</span><div><strong>@UiText.T("Pet-Fenster öffnen")</strong><p>@UiText.T("Reiter ALL wählen und ganz nach oben scrollen.")</p></div></li>
            <li><span>2</span><div><strong>@UiText.T("Scannen & stillhalten")</strong><p>@UiText.T("Warten, bis alle sichtbaren Werte gelesen sind. Dann langsam weiterscrollen.")</p></div></li>
            <li><span>3</span><div><strong>@UiText.T("Prüfen & übernehmen")</strong><p>@UiText.T("Unklare Pets im Spiel anklicken oder unten korrigieren.")</p></div></li>
        </ol>

        <div class="pet-scan-language"><OcrLanguageSetup Disabled="@Locked" /></div>

        <div class="pet-scan-actions">
            @if (Scan.Starting && !_readingFile)
            {
                <button class="btn primary busy" disabled><span class="spinner"></span>@UiText.T("Scan startet …")</button>
                <button class="btn" @onclick="StopScan">@UiText.T("Abbrechen")</button>
            }
            else if (Scan.Running)
            {
                <button class="btn danger" @onclick="StopScan"><span class="live-dot"></span>@UiText.T("Scan stoppen")</button>
            }
            else
            {
                <button class="btn primary" @onclick="StartScan" disabled="@Locked">@UiText.T("Scan starten")</button>
            }
            <button class="btn @(_readingFile ? "busy" : "")" @onclick="ScanFile" disabled="@Locked" title="@UiText.T("Statt live zu scannen: einen Screenshot des Pet-Fensters einlesen")">
                @if (_readingFile) { <span class="spinner"></span> }
                @UiText.T(_readingFile ? "Bild wird gelesen …" : "Bild einlesen …")
            </button>
            <span class="pet-scan-action-note">@UiText.T("Übernehmen ist auch während des Scans möglich.")</span>
        </div>

        <div class="pet-scan-current-page @(!Scan.StatusIsError && _page?.Ready == true ? "ready" : "")" role="status" aria-live="polite">
            <div class="pet-scan-page-copy">
                <span class="pet-scan-eyebrow">@UiText.T("Aktuelle Seite")</span>
                <strong>@PageTitle()</strong>
                <p>@PageAction()</p>
            </div>
            @if (_page is { Cards: > 0 } visiblePage)
            {
                <div class="pet-scan-page-metrics">
                    <strong>@visiblePage.Read <small>/ @visiblePage.Cards</small></strong>
                    <span>@UiText.T("Werte gelesen") · @UiText.T(visiblePage.Stable ? "stabil" : "bewegt")</span>
                    <progress value="@visiblePage.Read" max="@visiblePage.Cards" aria-label="@UiText.T("Gelesene Werte auf der sichtbaren Seite")"></progress>
                </div>
            }
        </div>
        <p class="pet-scan-page-note">@UiText.T("Der Seitenstatus gilt nur für die sichtbaren Karten, nicht für die gesamte Sammlung.")</p>
        <div class="pet-scan-feedback @(Scan.StatusIsError ? "error" : "")" role="status">@UiText.T(Scan.Status)</div>
        @if (_fileFeedback is not null)
        {
            <div class="pet-scan-feedback @(_fileError ? "error" : "success")" role="status">@_fileFeedback</div>
        }

        <div class="pet-scan-drawers">
            <details class="pet-scan-settings">
                <summary>@UiText.T("Aufnahmebereich & Hilfe")</summary>
                <div class="pet-scan-settings-body">
                    <div class="pet-scan-region">
                        <span>@UiText.T("Aufnahmebereich")</span>
                        <strong>@Scan.CaptureRegion.Width × @Scan.CaptureRegion.Height px @(Settings.Current.PetWindowRegion is null ? UiText.T("(Hauptbildschirm)") : "")</strong>
                        <div class="pet-scan-inline-actions">
                            <button class="btn small" @onclick="SelectRegion" disabled="@Locked">@UiText.T("Bereich wählen")</button>
                            <button class="btn small" @onclick="UsePrimaryScreen" disabled="@(Locked || Settings.Current.PetWindowRegion is null)">@UiText.T("Ganzer Bildschirm")</button>
                        </div>
                    </div>
                    <p>@UiText.T("Das ganze Pet-Fenster muss sichtbar sein. Bei fehlenden Werten kurz stillhalten oder das Pet im Spiel einmal anklicken.")</p>
                    <p>@UiText.T("Alt + Linksklick auf den erkannten Wert über der Kartenzahl öffnet die Korrektur.")</p>
                </div>
            </details>
            <details class="pet-scan-preview">
                <summary>@UiText.T("Vorschau & Scan-Details")</summary>
                <div class="pet-scan-preview-body">
                    @if (Scan.PreviewDataUrl is { } preview)
                    {
                        <figure><img src="@preview" alt="@UiText.T("Letzte Aufnahme")" /><figcaption>@UiText.T("Letzte Aufnahme")</figcaption></figure>
                    }
                    <div class="pet-scan-diagnostics">
                        <dl>
                            <div><dt>@UiText.T("Bilder gelesen")</dt><dd>@Scan.Frames</dd></div>
                            <div><dt>@UiText.T("Ausgewählt im Spiel")</dt><dd>@(Scan.PanelText ?? "–")</dd></div>
                            <div><dt>@UiText.T("Sammlung laut Spiel")</dt><dd>@(Scan.Collection is { } collection ? $"{collection.Owned} / {collection.Total}" : "–")</dd></div>
                            <div><dt>@UiText.T("Freigeschaltet erkannt")</dt><dd>@_overview.Unlocked</dd></div>
                        </dl>
                        @if (_page?.Missing.Count > 0)
                        {
                            <strong>@UiText.T("Auf dieser Seite noch prüfen")</strong>
                            <ul>@foreach (var missing in _page.Missing) { <li>@missing</li> }</ul>
                        }
                        @if (Scan.PreviewDataUrl is null)
                        {
                            <p>@UiText.T("Die Vorschau erscheint nach der ersten Aufnahme.")</p>
                        }
                    </div>
                </div>
            </details>
        </div>
    </section>

    <section class="pet-scan-summary" aria-label="@UiText.T("Scan-Übersicht")">
        <div class="pet-scan-count"><span>@UiText.T("Gelesene Pets")</span><strong>@_overview.Total</strong><small>@UiText.T("über alle gelesenen Seiten")</small></div>
        <button class="pet-scan-count @(_status == "ready" ? "selected" : "")" @onclick="@(() => SetStatus("ready"))" aria-pressed="@(_status == "ready")"><span>@UiText.T("Bereit zur Übernahme")</span><strong>@_overview.Ready</strong><small>@UiText.T("Pet und Wert erkannt")</small></button>
        <button class="pet-scan-count review @(_status == "review" ? "selected" : "")" @onclick="@(() => SetStatus("review"))" aria-pressed="@(_status == "review")"><span>@UiText.T("Prüfen")</span><strong>@_overview.Review</strong><small>@UiText.T("Zuordnung oder Wert unklar")</small></button>
        <button class="pet-scan-count @(_status == "selected" ? "selected" : "")" @onclick="@(() => SetStatus("selected"))" aria-pressed="@(_status == "selected")"><span>@UiText.T("Zur Übernahme markiert")</span><strong>@_overview.Selected</strong><small>@UiText.T("aus der gesamten Liste")</small></button>
    </section>

    <section class="card pet-scan-results" aria-label="@UiText.T("Scan-Ergebnisse prüfen")">
        <div class="pet-scan-section-heading">
            <h3>@UiText.T("Ergebnisse prüfen") <span>@UiText.F("{0} von {1}", _overview.Rows.Count, _overview.Total)</span></h3>
            @if (_overview.Total > 0)
            {
                <button class="btn small @(_confirmClear ? "danger" : "")" @onclick="ClearList" disabled="@Locked" title="@UiText.T("Gelesene Liste verwerfen (der Fortschritt bleibt unverändert)")">@UiText.T(_confirmClear ? "Wirklich leeren?" : "Liste leeren")</button>
            }
        </div>
        <div class="pet-scan-filters">
            <input class="pet-scan-search" type="text" value="@_search" @oninput="Search" placeholder="@UiText.T("Pet suchen …")" aria-label="@UiText.T("Gelesene Pets durchsuchen")" autocomplete="off" spellcheck="false" />
            <label>@UiText.T("Status")<select value="@_status" @onchange="@(e => SetStatus(e.Value?.ToString() ?? "all"))"><option value="all">@UiText.T("Alle Ergebnisse")</option><option value="review">@UiText.T("Prüfen")</option><option value="ready">@UiText.T("Bereit zur Übernahme")</option><option value="selected">@UiText.T("Zur Übernahme markiert")</option></select></label>
            @if (_search.Length > 0 || _status != "all")
            {
                <button class="btn small" @onclick="ResetFilters">@UiText.T("Filter zurücksetzen")</button>
            }
        </div>
        @if (_overview.Rows.Count > 0)
        {
            <div class="pet-scan-selection">
                <span>@UiText.T("Sichtbare, übernehmbare Pets:")</span>
                <button class="btn link" @onclick="@(() => SelectVisible(true))" disabled="@(!_overview.Rows.Any(row => row.Eligible))">@UiText.T("Alle markieren")</button>
                <button class="btn link" @onclick="@(() => SelectVisible(false))" disabled="@(!_overview.Rows.Any(row => row.Eligible))">@UiText.T("Markierung aufheben")</button>
            </div>
            <div class="pet-scan-entries">
                @foreach (var row in _overview.Rows)
                {
                    var entry = row.Entry;
                    var editing = _editingKey == entry.Key;
                    <article class="pet-scan-entry @(row.NeedsReview ? "review" : "ready")" data-status="@row.Status.ToString().ToLowerInvariant()" data-entry="@entry.Key" @key="entry.Key">
                        <div class="pet-scan-entry-main">
                            <input class="pet-scan-entry-check" type="checkbox" checked="@(entry.Apply && row.Eligible)" disabled="@(!row.Eligible)" @onchange="@(e => Scan.SetApply(entry.Key, e.Value is true))" aria-label="@UiText.T("Pet zur Übernahme markieren")" />
                            <img class="pet-scan-thumb" src="@entry.ThumbnailDataUrl" alt="" />
                            <div class="pet-scan-entry-name">
                                <strong>@(entry.PetId is null ? UiText.T("Unbekanntes Pet") : row.Name)</strong>
                                <span class="pet-scan-entry-status">@EntryStatus(row.Status)</span>
                                @if (entry.PetId is null && row.Name.Length > 0) { <small>@UiText.F("Ähnlich: {0}", row.Name)</small> }
                            </div>
                            <div class="pet-scan-entry-values">
                                <div><span>@UiText.T("Gelesen")</span><strong>@(entry.Reading is { } reading ? LevelText(reading.Level, reading.InLevel) : UiText.T(entry.HasValueConflict ? "Widersprüchlich" : "Nicht lesbar"))</strong><small>@ReadingSource(entry)</small></div>
                                <div><span>@UiText.T("Gespeichert")</span><strong>@(entry.PetId is { } id ? Progress.LevelText(id) : "–")</strong><small>@UiText.T("In Soulcrest")</small></div>
                            </div>
                            <button class="btn small pet-scan-edit" @onclick="@(() => ToggleCorrection(entry.Key))" aria-expanded="@editing" aria-controls="@($"pet-correction-{entry.Key}")">@UiText.T(editing ? "Schließen" : "Korrigieren")</button>
                        </div>
                        @if (editing)
                        {
                            <div class="pet-scan-correction" id="@($"pet-correction-{entry.Key}")">
                                <label class="pet-scan-assignment">@UiText.T("Pet-Zuordnung")
                                    <select value="@(entry.PetId ?? "")" @onchange="@(e => Assign(entry, e.Value?.ToString()))">
                                        <option value="">@UiText.T("– unbekannt –")</option>
                                        @foreach (var pet in _catalog) { <option value="@pet.Id">@pet.DisplayName(Settings.Current.NameLanguage)</option> }
                                    </select>
                                </label>
                                <div class="pet-scan-value-editor">
                                    <label for="@($"pet-value-{entry.Key}")">@UiText.T("Wert korrigieren")</label>
                                    <div><input id="@($"pet-value-{entry.Key}")" type="text" value="@_corrections.GetValueOrDefault(entry.Key, "")" @oninput="@(e => SetCorrection(entry.Key, e.Value?.ToString() ?? ""))" @onkeydown="@(e => { if (e.Key == "Enter") CorrectValue(entry.Key); })" placeholder="0/5, 12/25, 40/75, MAX" aria-describedby="@($"pet-value-help-{entry.Key}")" autocomplete="off" spellcheck="false" /><button class="btn small" @onclick="@(() => CorrectValue(entry.Key))">@UiText.T("Wert speichern")</button></div>
                                    <small id="@($"pet-value-help-{entry.Key}")">@UiText.T("Erlaubt: N/5, N/25, N/75 oder MAX.")</small>
                                    @if (_correctionFeedback.TryGetValue(entry.Key, out var feedback)) { <p class="@(_correctionErrors.Contains(entry.Key) ? "error" : "success")" role="status">@feedback</p> }
                                </div>
                                <p class="pet-scan-evidence">@ConfidenceText(entry) · @UiText.F("{0}× gesehen", entry.Seen) @if (entry.LastText.Length > 0) { <span>· «@entry.LastText»</span> }</p>
                            </div>
                        }
                    </article>
                }
            </div>
        }
        else
        {
            <div class="pet-scan-empty">@UiText.T(_overview.Total == 0 ? "Noch keine Pets gelesen. Scan starten oder ein Bild einlesen." : "Keine Pets passen zu diesen Filtern.")</div>
        }
        <div class="pet-scan-apply">
            <div><strong>@UiText.F("{0} Pets zur Übernahme markiert", _overview.Selected)</strong><span>@UiText.T("Übernimmt die markierten Pets aus allen Seiten und Filtern.")</span>
                @if (_entries.Any(entry => entry.Apply && entry.PetId is not null && entry.Reading is not null && (entry.Confidence is ScanConfidence.Uncertain or ScanConfidence.Unknown))) { <small>@UiText.T("Die Auswahl enthält unsichere Zuordnungen. Bitte vor dem Übernehmen prüfen.")</small> }
                @if (_applied is not null) { <span class="success" role="status">@_applied</span> }
            </div>
            <button class="btn primary @(_justApplied ? "done" : "")" @onclick="Apply" disabled="@(_overview.Selected == 0 || _justApplied)">@(_justApplied ? UiText.F("✓ {0} übernommen", _appliedCount) : UiText.F("Markierte übernehmen ({0})", _overview.Selected))</button>
        </div>
    </section>
</div>

@code {
    private IReadOnlyList<ScanEntry> _entries = [];
    private PetScanOverviewSnapshot _overview = new(0, 0, 0, 0, 0, []);
    private IReadOnlyList<PetDefinition> _catalog = [];
    private PetCatalog? _catalogSource;
    private string? _catalogLanguage;
    private ScanPageStatus? _page;
    private string _search = "", _status = "all";
    private string? _editingKey, _applied, _fileFeedback;
    private readonly Dictionary<string, string> _corrections = [];
    private readonly Dictionary<string, string> _correctionFeedback = [];
    private readonly HashSet<string> _correctionErrors = [];
    private readonly CancellationTokenSource _lifetime = new();
    private bool _readingFile, _fileError, _confirmClear, _justApplied, _disposed;
    private int _appliedCount, _savedUnlocked, _savedMax, _refreshQueued, _snapshotPending, _savedPending;
    private bool Locked => Scan.Running || Scan.Starting || _readingFile;

    protected override void OnInitialized()
    {
        Scan.Changed += ScanChanged;
        Progress.Changed += ProfileChanged;
        Settings.Changed += ProfileChanged;
        _entries = Scan.Entries;
        _page = Scan.Page;
        RebuildSaved();
        Rebuild();
    }

    private void ScanChanged() => QueueRefresh(snapshot: true);
    private void ProfileChanged() => QueueRefresh(snapshot: false);
    private void QueueRefresh(bool snapshot)
    {
        if (_disposed) return;
        if (snapshot) Interlocked.Exchange(ref _snapshotPending, 1);
        else Interlocked.Exchange(ref _savedPending, 1);
        if (Interlocked.Exchange(ref _refreshQueued, 1) == 0) _ = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                Interlocked.Exchange(ref _refreshQueued, 0);
                if (_disposed) return;
                if (Interlocked.Exchange(ref _snapshotPending, 0) != 0) _entries = Scan.Entries;
                if (Interlocked.Exchange(ref _savedPending, 0) != 0) RebuildSaved();
                _page = Scan.Page;
                Rebuild();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) when (_disposed) { }
    }

    private void RebuildSaved()
    {
        var souls = Progress.Catalog.Pets.Select(pet => Progress.Souls(pet.Id)).ToArray();
        _savedUnlocked = souls.Count(value => Progress.Thresholds.Level(value) >= 1);
        _savedMax = souls.Count(Progress.Thresholds.IsMax);
    }

    private void Rebuild()
    {
        var catalog = Progress.Catalog;
        var language = Settings.Current.NameLanguage;
        if (!ReferenceEquals(catalog, _catalogSource) || language != _catalogLanguage)
        {
            _catalog = catalog.Pets.OrderBy(pet => pet.DisplayName(language), StringComparer.OrdinalIgnoreCase).ToArray();
            _catalogSource = catalog;
            _catalogLanguage = language;
        }
        _overview = PetScanOverview.Build(_entries, catalog, language, _search, _status);
        if (Locked) _confirmClear = false;
        if (_editingKey is not null && !_entries.Any(entry => entry.Key == _editingKey)) _editingKey = null;
    }

    private void Search(ChangeEventArgs args) { _search = args.Value?.ToString() ?? ""; Rebuild(); }
    private void SetStatus(string status) { _status = status is "review" or "ready" or "selected" ? status : "all"; Rebuild(); }
    private void ResetFilters() { _search = ""; _status = "all"; Rebuild(); }
    private void SelectVisible(bool apply) => Scan.SetApply(_overview.Rows.Where(row => row.Eligible).Select(row => row.Entry.Key), apply);
    private Task StartScan() => Locked ? Task.CompletedTask : Scan.StartAsync();
    private void StopScan() { if (!_readingFile && (Scan.Running || Scan.Starting)) Scan.Stop(); }
    private void SelectRegion() { if (!Locked) Scan.SelectRegion(); }
    private void UsePrimaryScreen() { if (!Locked) Scan.UsePrimaryScreen(); }

    private async Task ScanFile()
    {
        if (Locked) return;
        using var dialog = new OpenFileDialog { Filter = UiText.T("Bilder|*.png;*.jpg;*.jpeg;*.bmp;*.webp|Alle Dateien|*.*"), Title = UiText.T("Screenshot des Pet-Fensters wählen") };
        if (dialog.ShowDialog() != DialogResult.OK || Locked) return;
        _fileFeedback = null;
        _fileError = false;
        _readingFile = true;
        _confirmClear = false;
        StateHasChanged();
        try
        {
            await Task.Run(() => Scan.ScanFileAsync(dialog.FileName));
            _fileError = Scan.StatusIsError;
            _fileFeedback = UiText.T(_fileError ? "Bild konnte nicht eingelesen werden. Scan-Status prüfen." : "Bild eingelesen. Ergebnisse unten prüfen und übernehmen.");
        }
        catch (Exception exception) { _fileError = true; _fileFeedback = UiText.T("Fehler: ") + exception.Message; }
        finally { _readingFile = false; }
    }

    private void ToggleCorrection(string key)
    {
        if (_editingKey == key) { _editingKey = null; return; }
        if (_entries.FirstOrDefault(entry => entry.Key == key) is not { } entry) return;
        _editingKey = key;
        if (!_corrections.ContainsKey(key)) _corrections[key] = CorrectionText(entry.Reading ?? entry.CandidateReading);
    }
    private void Assign(ScanEntry entry, string? petId)
    {
        if (string.IsNullOrEmpty(petId) || Progress.Catalog.Find(petId) is not null) Scan.Assign(entry, petId);
    }
    private void SetCorrection(string key, string value) { _corrections[key] = value; _correctionFeedback.Remove(key); _correctionErrors.Remove(key); }
    private void CorrectValue(string key)
    {
        if (Scan.CorrectValue(key, _corrections.GetValueOrDefault(key, "")))
        {
            _correctionErrors.Remove(key);
            _correctionFeedback[key] = UiText.T("Wert korrigiert. Zum Speichern im Fortschritt anschließend übernehmen.");
        }
        else
        {
            _correctionErrors.Add(key);
            _correctionFeedback[key] = UiText.T("Wert nicht übernommen. Bitte N/5, N/25, N/75 oder MAX eingeben.");
        }
    }

    private async Task AskClear()
    {
        if (Locked || _overview.Total == 0) return;
        _confirmClear = true;
        StateHasChanged();
        try { await Task.Delay(4000, _lifetime.Token); }
        catch (OperationCanceledException) { return; }
        _confirmClear = false;
    }
    private Task ClearList() => _confirmClear ? ClearConfirmed() : AskClear();
    private Task ClearConfirmed()
    {
        if (Locked || !_confirmClear) return Task.CompletedTask;
        _confirmClear = false;
        _applied = null;
        _editingKey = null;
        _corrections.Clear();
        _correctionFeedback.Clear();
        _correctionErrors.Clear();
        Scan.Clear();
        return Task.CompletedTask;
    }
    private async Task Apply()
    {
        if (_overview.Selected == 0 || _justApplied) return;
        _appliedCount = Scan.ApplySelected();
        _applied = UiText.F("{0} Pets um {1} in den Fortschritt übernommen.", _appliedCount, DateTime.Now.ToString("HH:mm:ss"));
        _justApplied = true;
        StateHasChanged();
        try { await Task.Delay(2000, _lifetime.Token); }
        catch (OperationCanceledException) { return; }
        _justApplied = false;
    }

    private string PageTitle() => UiText.T(Scan.StatusIsError ? "Scan konnte nicht abgeschlossen werden" : _readingFile ? "Bild wird gelesen …" : Scan.Starting ? "Scan wird vorbereitet" : _page is { Cards: > 0, Stable: false } ? "Liste bewegt sich" : _page?.Ready == true ? "Aktuelle Seite vollständig gelesen" : _page is { Cards: > 0 } ? "Noch nicht alle Werte lesbar" : Scan.Running ? "Warte auf das Pet-Fenster" : _overview.Total > 0 ? "Ergebnisse bereit zum Prüfen" : "Bereit für den Scan");
    private string PageAction() => UiText.T(Scan.StatusIsError ? "Scan-Status und Aufnahmebereich prüfen. Danach erneut starten oder ein anderes Bild einlesen." : _readingFile || Scan.Starting ? "Die Aufnahme wird vorbereitet. Einen Moment warten." : !Scan.Running && _overview.Total > 0 ? "Ergebnisse unten prüfen und markierte Pets übernehmen." : _page is { Cards: > 0, Stable: false } ? "Kurz stillhalten, bis die Aufnahme stabil ist." : _page?.Ready == true && Scan.Running ? "Langsam zur nächsten Seite scrollen." : _page is { Cards: > 0, Ready: false } ? "Liste stillhalten. Unklare Pets im Spiel einmal anklicken oder unten korrigieren." : !Scan.Running && _overview.Total > 0 ? "Ergebnisse unten prüfen und markierte Pets übernehmen." : "Pet-Fenster öffnen, Reiter ALL wählen und oben beginnen.");
    private static string CorrectionText((int Level, int InLevel)? value) => value is { } reading ? reading.Level == 3 ? "MAX" : $"{reading.InLevel}/{(reading.Level == 0 ? 5 : reading.Level == 1 ? 25 : 75)}" : "";
    private static string LevelText(int level, int inLevel) => level switch { 3 => UiText.T("Stufe 3 (max)"), 0 => UiText.F("nicht freigeschaltet · {0}/5", inLevel), 1 => UiText.F("Stufe 1 · {0}/25", inLevel), _ => UiText.F("Stufe 2 · {0}/75", inLevel) };
    private static string EntryStatus(PetScanEntryStatus status) => UiText.T(status switch { PetScanEntryStatus.Ready => "Bereit zur Übernahme", PetScanEntryStatus.UnknownPet => "Pet zuordnen", PetScanEntryStatus.UnreadableValue => "Wert fehlt", PetScanEntryStatus.ConflictingValue => "Wert widersprüchlich", _ => "Zuordnung prüfen" });
    private static string ReadingSource(ScanEntry entry) => UiText.T(entry.ManualReading is not null ? "Manuell korrigiert" : entry.PanelReading is not null ? "Im Panel bestätigt" : "Aus der Aufnahme");
    private static string ConfidenceText(ScanEntry entry) => entry.Confidence switch { ScanConfidence.Confirmed => UiText.T("Zuordnung bestätigt"), ScanConfidence.Recognised => UiText.F("Am Porträt erkannt ({0})", entry.MatchScore), ScanConfidence.Uncertain => UiText.F("Zuordnung unsicher ({0})", entry.MatchScore), _ => UiText.T("Pet im Spiel anklicken oder hier zuordnen") };

    public void Dispose()
    {
        _disposed = true;
        Scan.Changed -= ScanChanged;
        Progress.Changed -= ProfileChanged;
        Settings.Changed -= ProfileChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
