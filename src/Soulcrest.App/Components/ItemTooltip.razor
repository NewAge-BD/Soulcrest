@implements IAsyncDisposable
@inject IServiceProvider Services

<span class="item-tooltip @Class @(IsOpen ? "is-open" : "") @(_dismissed ? "is-dismissed" : "")"
    data-item-tooltip data-parent-focus="@(ParentFocus ? "true" : null)" tabindex="@(Focusable ? "0" : null)"
    role="@(Focusable ? "img" : null)" aria-label="@(Label ?? Text)" aria-describedby="@TooltipId"
    @attributes="AdditionalAttributes" @onmouseenter="Enter" @onmouseleave="Leave" @onfocusin="Focus" @onfocusout="Blur" @onkeydown="KeyDown" @ref="_trigger">
    @ChildContent
    <span id="@TooltipId" class="item-tooltip-body" role="tooltip" hidden="@(!IsOpen)" @onclick:stopPropagation @onpointerdown:stopPropagation @ref="_popup">
        @if (TooltipContent is not null) { @TooltipContent }
        else { <ItemName ItemId="ItemId" Grade="@Grade" Rarity="Rarity" DropKey="@DropKey" Text="@Text" /> }
    </span>
</span>

@code {
    [Parameter] public int? ItemId { get; set; }
    [Parameter] public string? Grade { get; set; }
    [Parameter] public LootItemRarity? Rarity { get; set; }
    [Parameter] public string? DropKey { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Focusable { get; set; } = true;
    [Parameter] public bool ParentFocus { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? TooltipContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private static long _nextId;
    private readonly string _generatedId = "item-tooltip-" + Interlocked.Increment(ref _nextId);
    private string TooltipId => Id ?? _generatedId;
    private ElementReference _trigger, _popup;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ItemTooltip>? _reference;
    private bool _hovered, _focused, _parentActive, _dismissed, _parentBound, _disposed;
    private bool IsOpen => !_dismissed && (_hovered || _focused || _parentActive);
    private void Enter() { if (!_focused && !_parentActive) _dismissed = false; _hovered = true; }
    private void Leave() { _hovered = false; if (!_focused && !_parentActive) _dismissed = false; }
    private void Focus() { if (!_hovered && !_parentActive) _dismissed = false; _focused = true; }
    private void Blur() { _focused = false; if (!_hovered && !_parentActive) _dismissed = false; }
    private void KeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") _dismissed = true; }
    [JSInvokable] public Task ParentTrigger(bool active) => InvokeAsync(() =>
    {
        if (_disposed) return;
        _parentActive = active; if (!active) _dismissed = false; StateHasChanged();
    });
    [JSInvokable] public Task Dismiss() => InvokeAsync(() => { _dismissed = true; StateHasChanged(); });
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || Services.GetService(typeof(IJSRuntime)) is not IJSRuntime runtime) return;
        if (_module is null && !IsOpen && !ParentFocus) return;
        try
        {
            _module ??= await runtime.InvokeAsync<IJSObjectReference>("import", "./js/item-controls.js");
            _reference ??= DotNetObjectReference.Create(this);
            if (ParentFocus && !_parentBound)
            {
                await _module.InvokeVoidAsync("bindTooltipParent", _trigger, _reference); _parentBound = true;
            }
            if (IsOpen) await _module.InvokeVoidAsync("placePopup", _trigger, _popup, "tooltip", ParentFocus, null, _reference);
            else await _module.InvokeVoidAsync("closePopupFor", _trigger);
        }
        catch (Exception error) when (error is JSException or InvalidOperationException) { }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
            try { await _module.InvokeVoidAsync("disposeTooltipParent", _trigger); await _module.InvokeVoidAsync("closePopupFor", _trigger); await _module.DisposeAsync(); }
            catch (Exception error) when (error is JSException or InvalidOperationException) { }
        _reference?.Dispose();
    }
}
