@* Passive network progress replaces OCR setup (user request 2026-10-12). *@
@inject SettingsService Settings
@inject UiState Ui
@inject IJSRuntime JS

<div class="tutorial-backdrop" role="dialog" aria-modal="true" aria-labelledby="tutorial-title">
    <div class="tutorial card" data-setup-step="overview">
        <video @ref="_video" class="tutorial-video" src="media/hud-tutorial.mp4" autoplay loop muted playsinline
               aria-label="@UiText.T("Im Spiel: Menü, Edit HUD, Minimap größer ziehen, dann die Minimap markieren")"></video>
        <div class="tutorial-side">
            <h2 id="tutorial-title">@UiText.T("Willkommen bei Soulcrest")</h2>
            <p class="sv-lead">@UiText.T("Minimap einrichten und Profil wählen. Pets und Erkundung werden passiv über das Netzwerk erkannt.")</p>
            <ol class="tutorial-steps">
                <li>
                    <b>@UiText.T("Minimap bei Bedarf vergrößern")</b>
                    <p class="sv-hint">@UiText.T("Im Spiel das Menü öffnen, „Edit HUD“ wählen und die Minimap an der Ecke etwas größer ziehen. Eine größere Minimap macht das Tracking sicherer.")</p>
                </li>
                <li><b>@UiText.T("Minimap markieren")</b><MapRegionPicker /></li>
                <li>
                    <b>@UiText.T("Deine Fraktion")</b>
                    <p class="sv-hint">@UiText.T("Die Wachen an den Kibelisken töten Spieler der anderen Fraktion mit einem Schlag. Soulcrest zeigt um sie eine rote Gefahrenzone auf der Karte, die für dich gefährlich ist.")</p>
                    <div class="row faction-choice" role="group" aria-label="@UiText.T("Deine Fraktion")">
                        <button type="button" class="btn @(Settings.Current.Faction == Factions.Elyos ? "primary" : "")" aria-pressed="@(Settings.Current.Faction == Factions.Elyos)" @onclick="@(() => Factions.Choose(Settings, Factions.Elyos))">Elyos</button>
                        <button type="button" class="btn @(Settings.Current.Faction == Factions.Asmodian ? "primary" : "")" aria-pressed="@(Settings.Current.Faction == Factions.Asmodian)" @onclick="@(() => Factions.Choose(Settings, Factions.Asmodian))">@UiText.T("Asmodier")</button>
                    </div>
                    <p class="sv-hint" role="status">@UiText.T(Settings.Current.Faction switch
                    {
                        Factions.Elyos => "Gefahrenzonen auf Altgard sind an.",
                        Factions.Asmodian => "Gefahrenzonen auf Verteron sind an.",
                        _ => "Ohne Auswahl bleiben die Gefahrenzonen aus (änderbar unter Overlay → Karten-Overlay).",
                    })</p>
                </li>
                <li>
                    <b>@UiText.T("Gemeinsame Pet-Sammlung und Charakterprofil für Erkundung")</b>
                    <CharacterPicker />
                    @* User request 2026-10-13: pet counting is global; only exploration needs the own character. *@
                    <p class="sv-hint"><b>@UiText.T("Fortschritt einmal einlesen")</b><br />@UiText.T("Neue Pet-Souls werden bei laufender Netzwerkquelle sofort für die gemeinsame Sammlung gezählt, auch ohne Charaktererkennung. Für den vollständigen Pet- und Erkundungsabgleich öffne einmal die Charakterauswahl und logge dich mit deinem Charakter wieder ein. Warte auf die Bestätigung unten. Ein Gebietswechsel liefert nicht immer eine vollständige Pet-Liste.")</p>
                    <NetworkProgressStatus />
                    <p class="sv-hint">@UiText.T("Für Dungeons und Strongholds zählt der Abschluss-Haken. Fehlende oder unbestätigte Einträge bleiben ohne Haken; daraus lässt sich kein früherer Nichtabschluss ableiten. Gespeicherte und manuelle Abschlüsse bleiben erhalten.")</p>
                </li>
            </ol>
            <div class="row tutorial-actions">
                <button type="button" class="btn" @onclick="OpenExploration">@UiText.T("Erkundungsfortschritt öffnen")</button>
                <button type="button" class="btn primary" @onclick="Close">@UiText.T("Fertig")</button>
            </div>
            <p class="sv-hint">@UiText.T("Der Bereich lässt sich später unter Optionen ändern; dort startet „Setup starten“ dieses Setup erneut.")</p>
        </div>
    </div>
</div>

@code {
    private ElementReference _video;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeAsync<bool>("soulcrestUi.playMuted", _video);
    }
    private void OpenExploration() { Close(); Ui.Navigate("exploration"); }
    private void Close()
    {
        if (!Settings.Current.TutorialDone) Settings.Update(s => s.TutorialDone = true);
        Ui.CloseTutorial();
    }
}
