@* The entries of one version (Patchnotes tab and update notice). *@
<ul class="@(ShowKind ? "pn-list" : "pn-list pn-grouped-list")">
    @foreach (var entry in Entries)
    {
        <li>
            @if (ShowKind && entry.Kind.Length > 0)
            {
                <span class="pn-kind @KindClass(entry.Kind)">@UiText.T(entry.Kind)</span>
            }
            else if (ShowKind)
            {
                <span aria-hidden="true"></span>
            }
            <span class="pn-text">
                @foreach (var span in PatchNotes.Spans(entry.Text))
                {
                    if (span.Code)
                    {
                        <code>@span.Text</code>
                    }
                    else if (span.Bold)
                    {
                        <b>@span.Text</b>
                    }
                    else
                    {
                        @span.Text
                    }
                }
            </span>
        </li>
    }
</ul>

@code {
    [Parameter] public bool ShowKind { get; set; } = true;

    [Parameter, EditorRequired] public IReadOnlyList<PatchNotes.Entry> Entries { get; set; } = [];

    private static string KindClass(string kind) => kind switch
    {
        "Neu" or "New" => "new",
        "Behoben" or "Fixed" => "fixed",
        "Verbessert" or "Improved" => "improved",
        _ => "changed",
    };
}
