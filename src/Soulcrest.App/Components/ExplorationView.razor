@implements IDisposable
@inject ExplorationService Exploration
@inject ExplorationScanService Scan
@inject ProgressService Progress
@inject SettingsService Settings
@inject MapTrackingService Tracking
@inject UiState Ui

@{
    var renderedCharacter = _renderedCharacter;
    var renderedMap = _map;
}
<div class="page exploration-page exploration-overview">
    <header class="exploration-heading">
        <span class="exploration-eyebrow">SOULCREST / @UiText.T("Charakterfortschritt")</span>
        <h2>@UiText.T(Title(Kind))</h2>
        <p>@UiText.T("Deine Erkundung im Blick. Offene Orte finden und Fortschritt verwalten.")</p>
    </header>

    <section class="card exploration-context" aria-label="@UiText.T("Charakter und Karte")">
        <CharacterPicker Compact="true" />
        <label class="exploration-map-field">@UiText.T("Karte")
            <select aria-label="@UiText.T("Karte wählen")" value="@_map" @onchange="PinMap" disabled="@Scan.Running">
                @foreach (var group in Progress.Maps.GroupBy(m => m.Group))
                {
                    <optgroup label="@UiText.T(group.Key)">
                        @foreach (var m in group) { <option value="@m.Id">@UiText.T(m.Label)</option> }
                    </optgroup>
                }
            </select>
        </label>
        <div class="exploration-follow">
            <button type="button" class="btn @(Settings.Current.ExplorationPinnedMap is null ? "following" : "")" disabled="@(Scan.Running || string.IsNullOrEmpty(_map))" @onclick="TogglePin" aria-pressed="@(Settings.Current.ExplorationPinnedMap is not null)">
                @UiText.T(Settings.Current.ExplorationPinnedMap is null ? "Karte fixieren" : "Spielkarte folgen")
            </button>
            <span class="exploration-map-source @(_selection.Source == "detected" ? "detected" : "")">@UiText.T(MapSource)</span>
        </div>
        <span class="exploration-context-note">@UiText.T("Fortschritt gilt für den gewählten Charakter.")</span>
    </section>

    <section class="exploration-summary" aria-label="@UiText.T("Gesamtübersicht")">
        <div class="exploration-total">
            <span class="exploration-eyebrow">@UiText.T("Gesamtübersicht")</span>
            <strong>@_overview.Completed <small>/ @_overview.Total</small></strong>
            <span>@UiText.F("Offene Orte: {0}", _overview.Total - _overview.Completed)</span>
        </div>
        @foreach (var category in _overview.Categories)
        {
            <button type="button" class="exploration-category-chip @(_kind == category.Kind ? "selected" : "")" aria-pressed="@(_kind == category.Kind)" @onclick="@(() => SelectKind(category.Kind))">
                <span class="exploration-category-heading"><span class="exploration-kind-symbol @category.Kind" aria-hidden="true">@KindSymbol(category.Kind)</span><strong>@UiText.T(Title(category.Kind))</strong></span>
                <span class="exploration-category-value">@category.Completed <small>/ @category.Total @UiText.T("fertig")</small></span>
                @if (category.Total > 0) { <progress value="@category.Completed" max="@category.Total" aria-label="@UiText.T(Title(category.Kind))"></progress> }
            </button>
        }
    </section>

    <section class="card exploration-next" aria-label="@UiText.T("Nächstes offenes Ziel")">
        <div class="exploration-next-copy">
            <span class="exploration-eyebrow">@UiText.T("Nächstes offenes Ziel")</span>
            @if (_overview.Next is { } next)
            {
                <strong>@next.Place.Name(Settings.Current.NameLanguage)</strong>
                <span>@UiText.T(Title(next.Place.Kind)) @if (next.Distance is { } distance) { <span aria-hidden="true">·</span> @DistanceLabel(distance) }</span>
            }
            else
            {
                <strong>@UiText.T(NextEmptyMessage)</strong>
            }
        </div>
        @if (_overview.Next is { } target)
        {
            <button class="btn primary" @onclick="@(() => Ui.ShowExplorationOnMap(target.Place))">@UiText.T("Auf Karte anzeigen") <span aria-hidden="true">↗</span></button>
        }
        else if (!_trackingRunning && _overview.Completed < _overview.Total)
        {
            <button class="btn" @onclick="@(() => Ui.Navigate("map"))">@UiText.T("Zum Spielertracking")</button>
        }
    </section>

    <section class="card exploration-checklist" aria-label="@UiText.T("Erkundungs-Checkliste")">
        <div class="exploration-checklist-heading"><h3>@UiText.T("Erkundungs-Checkliste")</h3><span>@UiText.F("Angezeigte Einträge: {0}", _overview.Rows.Count)</span></div>
        <div class="exploration-filters">
            <input class="exploration-search" type="search" autocomplete="off" spellcheck="false" aria-label="@UiText.T("Ort suchen")" placeholder="@UiText.T("Ort suchen …")" @bind="_search" @bind:event="oninput" @bind:after="Rebuild" />
            <label>@UiText.T("Kategorie")<select @bind="_kind" @bind:after="Rebuild"><option value="all">@UiText.T("Alle Kategorien")</option>@foreach (var category in _overview.Categories) { <option value="@category.Kind">@UiText.T(Title(category.Kind))</option> }</select></label>
            <label>@UiText.T("Status")<select @bind="_status" @bind:after="Rebuild"><option value="all">@UiText.T("Alle")</option><option value="open">@UiText.T("Offen")</option><option value="done">@UiText.T("Erledigt")</option><option value="locked">@UiText.T("Gesperrt")</option></select></label>
            @if (_search.Length > 0 || _kind != "all" || _status != "all") { <button class="btn link" @onclick="ResetFilters">@UiText.T("Filter zurücksetzen")</button> }
        </div>
        @if (_overview.Rows.Count == 0)
        {
            <div class="exploration-list-empty">@UiText.T(_overview.Total == 0 ? "Für diese Karte sind keine Erkundungsorte hinterlegt." : "Keine Orte passen zu deinen Filtern.")</div>
        }
        else
        {
            <ul class="exploration-rows" tabindex="0" aria-label="@UiText.T("Erkundungs-Checkliste")">
                @foreach (var row in _overview.Rows)
                {
                    <li @key="row.Place.Id" class="exploration-place @(row.Done ? "done" : row.Locked ? "locked" : "")" data-place="@row.Place.Id">
                        <input type="checkbox" checked="@row.Done" disabled="@Scan.Running" aria-label="@UiText.F("{0} abgeschlossen", row.Place.Name(Settings.Current.NameLanguage))" @onchange="@(e => SetDone(row.Place, e, renderedCharacter, renderedMap))" />
                        <span class="exploration-kind-symbol @row.Place.Kind" aria-hidden="true">@KindSymbol(row.Place.Kind)</span>
                        <div class="exploration-place-copy"><strong>@row.Place.Name(Settings.Current.NameLanguage)</strong><span>@UiText.T(Title(row.Place.Kind))
                            @if (row.Locked) { <span class="exploration-locked-label">@UiText.T("Gesperrt")</span> }
                            else if (row.Done) { <span class="exploration-done-label">@UiText.T("Erledigt")</span> }
                        </span>
                            @if (row.Locked) { <small>@UiText.F("Benötigt: {0}", string.Join(", ", row.Missing.Select(p => p.Name(Settings.Current.NameLanguage))))</small> }
                        </div>
                        @if (row.Distance is { } distance) { <span class="exploration-place-distance">@DistanceLabel(distance)</span> }
                        <button type="button" class="btn exploration-place-focus" title="@UiText.T("Auf Karte anzeigen")" aria-label="@UiText.F("{0} auf Karte anzeigen", row.Place.Name(Settings.Current.NameLanguage))" @onclick="@(() => Ui.ShowExplorationOnMap(row.Place))"><span>@UiText.T("Karte")</span><span aria-hidden="true">↗</span></button>
                    </li>
                }
            </ul>
        }
        <p class="exploration-checklist-note">@UiText.T(Scan.Running ? "Manuelle Änderungen sind während des Scans gesperrt." : "Haken setzen oder entfernen, um den gespeicherten Fortschritt zu korrigieren.")</p>
    </section>

    <details class="exploration-scan-drawer" open="@Scan.Running">
        <summary><span><strong>@UiText.T("Fortschritt aus dem Spiel einlesen")</strong><small>@UiText.T(Scan.Running ? "Scan läuft – hier stoppen oder den Status prüfen." : "Bereits erledigte Orte per Scan übernehmen.")</small></span><span class="exploration-scan-drawer-state">@UiText.T(Scan.Running ? "Aktiv" : "Scan öffnen")</span></summary>
        <ExplorationScanPanel Map="@_map" Kind="@Kind" HasPlaces="@(_overview.Total > 0)" />
    </details>
</div>
@code {
    [Parameter] public string Kind { get; set; } = "all";
    internal static string Title(string kind) => kind switch { "dungeon" => "Versiegelte Dungeons", "stronghold" => "Garnisonen", "kibelisk" => "Kibelisk", _ => "Erkundungsfortschritt" };
    private string _map = "", _search = "", _kind = "all", _status = "all", _parameterKind = "";
    private ExplorationOverviewSnapshot _overview = null!;
    private ExplorationMapSelection _selection = null!;
    private PlayerPosition? _position;
    private string _renderedCharacter = "";
    private bool _trackingRunning, _playerOnOtherMap;
    private string NextEmptyMessage => _overview.Total == 0 ? "Keine Erkundungsorte auf dieser Karte."
        : _overview.Completed == _overview.Total ? "Alle Orte auf dieser Karte abgeschlossen."
        : !_trackingRunning ? "Spielertracking im Karten-Tab aktivieren."
        : _playerOnOtherMap ? "Für diese Karte liegt keine Spielerposition vor."
        : _position is null ? "Spielerposition für das nächste Ziel benötigt."
        : "Kein verfügbares offenes Ziel. Prüfe die Voraussetzungen oder wähle eine andere Kategorie.";
    private System.Threading.Timer? _freshnessTimer;
    private int _trackingQueued;
    private DateTime _lastTrackingRender;
    private volatile bool _disposed;
    private string MapSource => _selection.Source switch { "scan" => "Karte des laufenden Scans", "pinned" => "Manuell fixiert", "detected" => _selection.WorldMap ? "Automatisch erkannt · Weltkarte" : "Automatisch erkannt · Spielkarte", _ => "Zuletzt gewählt · warte auf Erkennung" };
    private static string KindSymbol(string kind) => kind switch { "dungeon" => "▣", "stronghold" => "⚑", _ => "◇" };
    private string DistanceLabel(double pixels) => Progress.Maps.FirstOrDefault(m => m.Id == _map)?.MetersPerPixel is { } meters ? UiText.F("{0} m", Math.Round(pixels * meters)) : UiText.F("{0} Kartenpixel", Math.Round(pixels));
    protected override void OnInitialized()
    {
        Exploration.Changed += Refresh;
        Settings.Changed += Refresh;
        Scan.Changed += Refresh;
        Tracking.Changed += RefreshTracking;
        _freshnessTimer = new System.Threading.Timer(_ => RefreshTracking(), null, 1000, 1000);
    }
    protected override void OnParametersSet()
    {
        if (_parameterKind != Kind) { _parameterKind = Kind; _kind = Kind; }
        Rebuild();
    }
    private void Rebuild()
    {
        var tracking = ExplorationOverview.Capture(Tracking);
        var profile = Exploration.Snapshot();
        var now = DateTimeOffset.UtcNow;
        _selection = ExplorationOverview.SelectMap(Progress.Maps, _map, Settings.Current.LastMap, Settings.Current.ExplorationPinnedMap, Scan.Running, Scan.ScanMap, tracking, now);
        _map = _selection.MapId;
        var position = ExplorationOverview.FreshPosition(tracking, now);
        _trackingRunning = tracking.Running;
        _playerOnOtherMap = position is not null && position.MapId != _map;
        _position = position?.MapId == _map ? position : null;
        _renderedCharacter = profile.CharacterId;
        _overview = ExplorationOverview.Build(Exploration.Places, profile.Completed, _map, Settings.Current.NameLanguage, _position, _search, _kind, _status);
    }
    private void PinMap(ChangeEventArgs e)
    {
        if (Scan.Running || e.Value?.ToString() is not { } map || !Progress.Maps.Any(m => m.Id == map)) return;
        Settings.Update(s => s.ExplorationPinnedMap = map);
    }
    private void TogglePin()
    {
        if (Scan.Running) return;
        Settings.Update(s => s.ExplorationPinnedMap = s.ExplorationPinnedMap is null ? _map : null);
    }
    private void SelectKind(string kind) { _kind = _kind == kind ? "all" : kind; Rebuild(); }
    private void ResetFilters() { _search = ""; _kind = "all"; _status = "all"; Rebuild(); }
    private void SetDone(ExplorationPlace place, ChangeEventArgs e, string character, string map)
    {
        if (Scan.Running || character != Exploration.ActiveId || map != _map || place.Map != map) return;
        Exploration.SetDone(character, [place.Id], e.Value is true);
    }
    private void Refresh()
    {
        if (_disposed) return;
        _ = RenderSafelyAsync(() => { if (_disposed) return; Rebuild(); StateHasChanged(); });
    }
    private async Task RenderSafelyAsync(Action refresh)
    {
        try { await InvokeAsync(refresh); }
        catch (ObjectDisposedException) when (_disposed) { }
        catch (InvalidOperationException) when (_disposed) { }
    }
    private void RefreshTracking()
    {
        if (_disposed || Interlocked.Exchange(ref _trackingQueued, 1) != 0) return;
        _ = RenderSafelyAsync(() =>
        {
            Volatile.Write(ref _trackingQueued, 0);
            if (_disposed || DateTime.UtcNow - _lastTrackingRender < TimeSpan.FromMilliseconds(900)) return;
            _lastTrackingRender = DateTime.UtcNow;
            Rebuild(); StateHasChanged();
        });
    }
    public void Dispose()
    {
        _disposed = true; _freshnessTimer?.Dispose();
        Exploration.Changed -= Refresh; Settings.Changed -= Refresh; Scan.Changed -= Refresh; Tracking.Changed -= RefreshTracking;
    }
}
