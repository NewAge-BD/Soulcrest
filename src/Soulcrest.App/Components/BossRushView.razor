@implements IDisposable
@inject BossRushService BossRush
@inject SettingsService Settings
@inject TrackerService Loot
@inject MapTargetsService Targets
@inject ProgressService Progress
@inject UiState Ui

@{
    var view = BossRush.View;
    var schedule = BossRush.Schedule.Where(row => row.Place.Map == view.MapId).ToArray();
    var spawned = schedule.Where(r => r.Spawned).ToArray();
    var upcoming = schedule.Where(r => !r.Spawned).ToArray();
    var currentMap = Progress.Maps.FirstOrDefault(m => m.Id == view.MapId);
}

<div class="page boss-page boss-dashboard">
    <div class="boss-dashboard-shell">
    <header class="sv-head boss-page-head">
        <div class="boss-page-title">
            <span class="boss-page-symbol" aria-hidden="true">◆</span>
            <div><span class="boss-panel-kicker">SOULCREST</span><h2>Boss Rush Mode</h2></div>
            <InfoTip><p>@UiText.T("Bestätigten Spawns folgen, kommende Spawns im Blick behalten.")</p></InfoTip>
        </div>
        <label class="opt-toggle boss-mode-toggle"><input type="checkbox" id="boss-rush-mode" role="switch" checked="@Settings.Current.BossRushEnabled" @onchange="ToggleMode" /> @UiText.T("Wegführung")</label>
    </header>

    <dl class="boss-dashboard-summary">
        <div class="boss-dashboard-stat spawned"><dt>@UiText.T(view.Cached ? "Zuletzt gemeldete Spawns" : "Gespawnt")</dt><dd>@spawned.Length</dd></div>
        <div class="boss-dashboard-stat upcoming"><dt>@UiText.T("Geplant")</dt><dd>@upcoming.Length</dd></div>
        <div class="boss-dashboard-stat selected"><dt>@UiText.T("Alert-Auswahl")</dt><dd>@Settings.Current.BossAlertIds.Length</dd></div>
    </dl>

    <div class="boss-layout boss-dashboard-columns">
        <div class="boss-main">
            <section class="card sv-card boss-command @(Settings.Current.BossRushEnabled ? "enabled" : "paused")" aria-label="@UiText.T("Wegführung")">
                @if (Settings.Current.BossRushEnabled)
                {
                    @if (view.Boss is { } boss)
                    {
                        <div class="boss-command-main">
                            @if (Icon(boss) is { } icon) { <img class="boss-portrait" src="@icon" alt="" /> }
                            else { <span class="boss-portrait boss-icon-fallback" aria-hidden="true">◆</span> }
                            <div class="boss-target-copy">
                                <span class="boss-panel-kicker">@UiText.T(view.Spawned ? "Aktuelles Ziel" : "Nächster Spawn")</span>
                                <h3>@boss.Name(Settings.Current.NameLanguage)</h3>
                                <div class="boss-target-state"><span class="boss-status-dot @(view.Spawned && !view.Cached ? "" : "preview")" aria-hidden="true"></span><span>@(view.Cached && view.Spawned ? UiText.T("Zuletzt als gespawnt gemeldet") : !view.Spawned && view.Remaining > TimeSpan.Zero ? UiText.T("Geplant") : Status(view.Spawned, view.Remaining))</span></div>
                                @if (currentMap is not null) { <span class="boss-map-label">@UiText.T(currentMap.Label)</span> }
                            </div>
                            @if (!view.Spawned && view.Remaining > TimeSpan.Zero)
                            {
                                <div class="boss-target-time" aria-label="@Status(false, view.Remaining)"><span>@UiText.T("Nächster Spawn")</span><strong>@BossRushService.Countdown(view.Remaining)</strong></div>
                            }
                        </div>
                        <div class="boss-command-footer">
                            <div class="boss-data-state @(view.Cached ? "cached" : "captured")"><span class="boss-status-dot @(view.Cached ? "preview" : "")" aria-hidden="true"></span><div><strong>@UiText.T(view.Cached ? "Gespeicherter Stand" : "Bossliste erfasst")</strong><span>@UiText.T("Countdowns laufen weiter")</span></div></div>
                            @if ((Targets.BossRush ?? Targets.BossPreview) is { } target)
                            {
                                <button class="btn" @onclick="@(() => Ui.ShowBossOnMap(target))">@UiText.T(view.Cached && view.Spawned ? "Nächsten Spawn auf Karte zeigen" : "Auf Karte zeigen") <span aria-hidden="true">↗</span></button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="boss-empty boss-command-empty"><span class="boss-empty-mark" aria-hidden="true">◷</span><h3>@UiText.T("Noch keine Bossliste vorhanden")</h3><p>@UiText.T("Warte auf Boss-Timer. Öffne die Bossliste im Spiel.")</p></div>
                    }
                    @if (!Loot.Running) { <button class="btn boss-tracker-start" @onclick="Loot.Start">@UiText.T("Loot-Tracker starten")</button> }
                }
                else
                {
                    <div class="boss-empty boss-command-empty"><span class="boss-empty-mark" aria-hidden="true">◷</span><h3>@UiText.T("Boss Rush pausiert")</h3><p>@UiText.T("Aktiviere Boss Rush für Wegführung und Spawn-Overlay. Aktivierte Boss-Alerts bleiben eingeschaltet.")</p></div>
                }
            </section>

            <LiveBossTimers IncludeAllCaptured="true" IncludeCatalogue="true" Compact="true" Searchable="true" />
        </div>

        <aside class="boss-settings" aria-label="@UiText.T("Einstellungen")">
            <section class="card sv-card boss-setting-card">
                <div class="boss-panel-heading"><div><span class="boss-panel-kicker">@UiText.T("Ingame-Anzeige")</span><h3>@UiText.T("Spawn-Overlay")</h3></div></div>
                <label class="opt-toggle"><input type="checkbox" role="switch" checked="@Settings.Current.BossOverlayEnabled" @onchange="@(e => Settings.Update(s => s.BossOverlayEnabled = (bool)e.Value!))" /> @UiText.T("Nächste Spawns im Overlay anzeigen")</label>
                <div class="boss-setting-grid">
                    <label class="boss-field">@UiText.T("Anzahl der Spawns") <input type="number" min="1" max="12" value="@Settings.Current.BossOverlayCount" @onchange="SetCount" /></label>
                    <label class="boss-field boss-scale-field">@UiText.T("Overlay-Größe") <span><input type="range" min="60" max="200" step="5" value="@((int)(Settings.Current.BossOverlayScale * 100))" @onchange="SetScale" /><output>@((int)(Settings.Current.BossOverlayScale * 100)) %</output></span></label>
                </div>
                <div class="boss-overlay-help"><kbd>Alt</kbd><span>@UiText.T("Ingame-Anzeige")</span><InfoTip><p>@UiText.T("Gedrückt halten, um Overlays zu bedienen und zu verschieben. Nach dem Loslassen sind sie wieder klickdurchlässig.")</p></InfoTip></div>
            </section>
        </aside>
    </div>

    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        BossRush.Changed += Refresh;
        Settings.Changed += Refresh;
        Loot.Changed += Refresh;
    }
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    private void ToggleMode(ChangeEventArgs e)
    {
        var enabled = (bool)e.Value!;
        Settings.Update(s => s.BossRushEnabled = enabled);
        if (enabled && !Loot.Running) Loot.Start();
    }
    private string? Icon(BossPlace boss) => boss.Icon is { } icon ? $"https://{MainForm.MapDataHost}/{icon}" : null;
    private static string Status(bool spawned, TimeSpan remaining) => spawned ? UiText.T("Bereits gespawnt")
        : remaining > TimeSpan.Zero ? UiText.F("Spawn in {0}", BossRushService.Countdown(remaining)) : UiText.T("Spawn fällig · warte auf Bestätigung");
    private void SetCount(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var n)) Settings.Update(s => s.BossOverlayCount = Math.Clamp(n, 1, 12)); }
    private void SetScale(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var n)) Settings.Update(s => s.BossOverlayScale = Math.Clamp(n, 60, 200) / 100d); }
    public void Dispose() { BossRush.Changed -= Refresh; Settings.Changed -= Refresh; Loot.Changed -= Refresh; }
}
