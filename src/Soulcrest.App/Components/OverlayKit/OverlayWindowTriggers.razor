@{ var rules = CurrentRules; }

<section class="menu-panel oe-display-panel oe-window-triggers" aria-labelledby="@(_id + "-title")">
    <div class="oe-display-heading oe-visibility-heading">
        <h2 id="@(_id + "-title")">@T("Sichtbarkeitsbedingungen")</h2>
        @ChildContent
    </div>
    <fieldset class="oe-area-fieldset" aria-describedby="@(_id + "-area-note")">
        <legend>@T("Gebiete")</legend>
        <div class="oe-display-options">
            @foreach (var area in Areas)
            {
                <label class="oe-display-choice oe-area-choice">
                    <input type="checkbox" checked="@rules.Areas.Contains(area.Value)" @onchange="e => SetArea(area.Value, e.Value is true)" />
                    <span>@T(area.Label)</span>
                </label>
            }
        </div>
        <p class="oe-display-hint" id="@(_id + "-area-note")">@T("Ohne Gebietsauswahl sind alle Gebiete erlaubt.")</p>
    </fieldset>
    <div class="oe-condition-list">
        @foreach (var condition in Conditions)
        {
            var group = _id + "-" + condition.Key;
            var selected = Read(rules, condition.Key);
            <div class="oe-condition" role="radiogroup" aria-labelledby="@(group + "-label")">
                <span class="oe-condition-label" id="@(group + "-label")">@T(condition.Label)</span>
                <div class="oe-condition-options">
                    @foreach (var option in Requirements)
                    {
                        <label class="oe-display-choice">
                            <input type="radio" name="@group" value="@option.Value" checked="@(selected == option.Value)"
                                   @onchange="() => SetRequirement(condition.Key, option.Value)" />
                            <span>@T(option.Label)</span>
                        </label>
                    }
                </div>
            </div>
        }
    </div>
    <p class="oe-display-hint">@T("Alle weiteren Bedingungen müssen gemeinsam erfüllt sein. Unbekannte Zustände erfüllen keine erforderliche oder ausgeschlossene Bedingung.") @T("Die globale Vordergrundregel gilt zusätzlich.")</p>
</section>

@code {
    [Parameter] public OverlayTriggerRules? Rules { get; set; }
    [Parameter] public EventCallback<OverlayTriggerRules?> RulesChanged { get; set; }
    [Parameter] public Func<string, string>? UiT { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly string _id = "overlay-window-triggers-" + Guid.NewGuid().ToString("N");
    private OverlayTriggerRules CurrentRules => OverlayTriggerRules.Normalize(Rules) ?? new();
    private string T(string text) => UiT?.Invoke(text) ?? text;
    private static readonly (OverlayTriggerArea Value, string Label)[] Areas =
    [
        (OverlayTriggerArea.OpenWorld, "Offene Welt"),
        (OverlayTriggerArea.Abyss, "Abyss"),
        (OverlayTriggerArea.Instances, "Instanzen"),
    ];
    private static readonly (string Key, string Label)[] Conditions =
    [
        ("foreground", "Spiel im Vordergrund"),
        ("session", "Laufende Session"),
        ("world-map", "Weltkarte geöffnet"),
        ("esc-menu", "ESC-Menü geöffnet"),
        ("minimap-missing", "Keine Minimap erkannt"),
    ];

    private static readonly (OverlayTriggerRequirement Value, string Label)[] Requirements =
    [
        (OverlayTriggerRequirement.Any, "Egal"),
        (OverlayTriggerRequirement.Required, "Erforderlich"),
        (OverlayTriggerRequirement.Excluded, "Ausgeschlossen"),
    ];

    private Task SetArea(OverlayTriggerArea area, bool enabled)
    {
        var current = CurrentRules;
        var areas = current.Areas.ToHashSet();
        if (enabled) areas.Add(area); else areas.Remove(area);
        return RulesChanged.InvokeAsync(OverlayTriggerRules.Normalize(current with { Areas = areas.ToArray() }));
    }

    private Task SetRequirement(string key, OverlayTriggerRequirement requirement)
    {
        var current = CurrentRules;
        var next = key switch
        {
            "foreground" => current with { Foreground = requirement },
            "session" => current with { SessionActive = requirement },
            "world-map" => current with { WorldMap = requirement },
            "esc-menu" => current with { EscMenu = requirement },
            "minimap-missing" => current with { MinimapMissing = requirement },
            _ => current,
        };
        return RulesChanged.InvokeAsync(OverlayTriggerRules.Normalize(next));
    }

    private static OverlayTriggerRequirement Read(OverlayTriggerRules rules, string key) => key switch
    {
        "foreground" => rules.Foreground,
        "session" => rules.SessionActive,
        "world-map" => rules.WorldMap,
        "esc-menu" => rules.EscMenu,
        "minimap-missing" => rules.MinimapMissing,
        _ => OverlayTriggerRequirement.Any,
    };
}
