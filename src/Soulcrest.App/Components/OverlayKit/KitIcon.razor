<svg class="icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "live": <path d="M3 12h4l3-8 4 16 3-8h4" /> break;
        case "history": <path d="M3 11a9 9 0 1 1 2.6 7M3 4v7h7M12 7v5l3 2" /> break;
        case "settings": <path d="M4 7h16M4 17h16M8 4v6M16 14v6" /> break;
        case "play": <path d="m8 5 11 7-11 7Z" fill="currentColor" stroke="none" /> break;
        case "pause": <path d="M8 5v14M16 5v14" stroke-width="4" /> break;
        case "plus": <path d="M12 5v14M5 12h14" /> break;
        case "upload": <path d="M12 16V3m-5 5 5-5 5 5M4 15v5h16v-5" /> break;
        case "share": <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4" /> break;
        case "download": <path d="M12 3v13m-5-5 5 5 5-5M4 17v4h16v-4" /> break;
        case "copy": <rect x="8" y="8" width="12" height="13" rx="2" /><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h3" /> break;
        case "arrow": <path d="M5 12h14m-5-5 5 5-5 5" /> break;
        case "back": <path d="M19 12H5m5-5-5 5 5 5" /> break;
        case "chevron": <path d="m9 5 7 7-7 7" /> break;
        case "down": <path d="m5 9 7 7 7-7" /> break;
        case "clock": <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /> break;
        case "loot": <path d="m12 3 9 5v9l-9 5-9-5V8l9-5Zm0 9v10M3 8l9 4 9-4M7.5 5.5l9 5v4" /> break;
        case "market": <path d="m3 10 2-6h14l2 6M5 13v7h14v-7M9 20v-6h6v6" /><path d="M3 10a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0" /> break;
        case "silver": <circle cx="12" cy="12" r="8.5" /><path d="m12 6-4 6 4 6 4-6-4-6Z" /> break;
        case "trend": <path d="m3 17 6-6 4 3 8-9M15 5h6v6" /> break;
        case "search": <circle cx="10" cy="10" r="6" /><path d="m15 15 6 6" /> break;
        case "check": <path d="m5 12 4 4L19 6" /> break;
        case "close": <path d="m6 6 12 12M18 6 6 18" /> break;
        case "edit": <path d="m15 4 5 5M4 20l5-1L21 7a2 2 0 0 0-5-5L4 15v5Z" /> break;
        case "delete": <path d="M3 6h18M9 6V3h6v3M6 6l1 15h10l1-15M10 10v7M14 10v7" /> break;
        case "more": <circle cx="5" cy="12" r="1.3" fill="currentColor" stroke="none" /><circle cx="12" cy="12" r="1.3" fill="currentColor" stroke="none" /><circle cx="19" cy="12" r="1.3" fill="currentColor" stroke="none" /> break;
        case "monitor": <rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8M12 17v4" /> break;
        case "shield": <path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z" /><path d="m8 12 3 3 5-6" /> break;
        case "spark": <path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z" /> break;
        case "refresh": <path d="M20 10a8 8 0 0 0-14-5L3 8m0-5v5h5M4 14a8 8 0 0 0 14 5l3-3m0 5v-5h-5" /> break;
        case "pin": <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 0 1 14 0Z" /><circle cx="12" cy="10" r="2" /> break;
        case "info": <circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7h.01" /> break;
        case "key": <circle cx="8" cy="9" r="5" /><path d="m12 13 8 8M16 17l3-3M18 19l3-3" /> break;
        default: <circle cx="12" cy="12" r="3" /> break;
    }
</svg>
@code {
    [Parameter] public string Name { get; set; } = "live";
    [Parameter] public string? Class { get; set; }
}
