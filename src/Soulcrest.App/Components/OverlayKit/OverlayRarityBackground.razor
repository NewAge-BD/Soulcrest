@using Soulcrest.App.Overlay
@using Soulcrest.App.Services

@if (LootRarityVisuals.HasAnimatedBackground(Rarity))
{
    <span class="overlay-rarity-background rarity-@Rarity.ToString().ToLowerInvariant() @(!AnimationsEnabled ? "is-motion-disabled" : "")"
          aria-hidden="true" style="@BackgroundStyle"></span>
}

@code {
    [Parameter] public LootItemRarity Rarity { get; set; }
    [Parameter] public bool AnimationsEnabled { get; set; } = true;
    [Parameter] public DateTimeOffset ClockUtcNow { get; set; }

    private double? _phase;
    // A shared clock aligns newly mounted copies. Keep the initial offset during
    // snapshot/quantity updates so the compositor's animation continues undisturbed.
    protected override void OnParametersSet() => _phase ??= Math.Max(0, ClockUtcNow.ToUnixTimeMilliseconds() / 1000d);
    private string BackgroundStyle
    {
        get
        {
            var color = LootRarityVisuals.Accent(Rarity);
            return FormattableString.Invariant($"--rarity-glow:{color.R},{color.G},{color.B};--rarity-phase:-{_phase:0.###}s");
        }
    }
}
