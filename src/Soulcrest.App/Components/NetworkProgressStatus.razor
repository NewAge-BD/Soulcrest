@implements IDisposable
@inject Soulcrest.App.Network.NetworkLootService Network
@inject SettingsService Settings

@{
    var sources = Network.ProgressSources;
    var state = SourceState(sources);
    var isLive = HasScopedBaseline(sources);
    var initialized = ScopedComplete(sources);
}
<section class="card network-progress" aria-label="@UiText.T("Netzwerkfortschritt")" data-progress-source="network" data-progress-live="@isLive.ToString().ToLowerInvariant()" data-progress-state="@state" data-progress-initialized="@initialized.ToString().ToLowerInvariant()" data-pet-counting="@sources.PetCanCount.ToString().ToLowerInvariant()">
    <div class="network-progress-heading">
        <h3>@UiText.T("Netzwerkfortschritt")</h3>
        <span class="pill @(state == "current" ? "live" : "warn")">@UiText.T(state switch { "current" => "Aktuell", "partial" => "Teilweise empfangen", _ => Scope == "pet" && sources.PetCanCount ? "Bereit zum Empfang" : "Wartet auf Bestätigung" })</span>
    </div>
    <p role="status">@UiText.T(StatusText(sources, state))</p>
    @if (Scope != "pet" && sources.IdentityIsLive && sources.Character is { } character)
    {
        <p class="note">@UiText.F("Erkanntes Charakterprofil: {0}", character)</p>
    }
    <dl class="network-baselines">
        @if (Scope != "exploration")
        {
            <div><dt>@UiText.T("Pet-Baseline")</dt><dd>@Baseline(sources.PetBaselineAt)</dd></div>
        }
        @if (Scope != "pet")
        {
            <div><dt>@UiText.T("Exploration Progress") <InfoTip><p>@UiText.T("Exploration Progress zeigt die verfügbaren Dungeon- und Stronghold-Daten deines Charakters. Belegte Abschlüsse erhalten einen Haken. Fehlende Einträge bleiben ohne Haken und beweisen nicht, dass ein Ort noch nie abgeschlossen wurde.")</p></InfoTip></dt><dd>@Baseline(sources.QuestBaselineAt)</dd></div>
            <div><dt>@UiText.T("Kibelisk-Baseline")</dt><dd>@Baseline(sources.TeleportBaselineAt)</dd></div>
        }
    </dl>
    <p class="note">@UiText.T(Scope == "pet"
        ? "Pets nutzen eine gemeinsame Sammlung in Soulcrest. Neue Soul-Gewinne werden ohne Charakter- oder Serverauswahl erfasst. Gespeicherte Werte bleiben bis zum vollständigen Abgleich erhalten."
        : "Fortschritt wird passiv aus dem Spielverkehr gelesen. Gespeicherte Profile bleiben erhalten; unbestätigte Zustände werden nicht als erledigt übernommen.")</p>
</section>

@code {
    [Parameter] public string Scope { get; set; } = "all";
    private bool _disposed;
    private bool HasScopedBaseline(Soulcrest.App.Network.NetworkProgressSources sources) => Scope switch
    {
        "pet" => sources.PetCanCount && sources.PetBaselineAt is not null,
        "exploration" => sources.IdentityIsLive && (sources.QuestBaselineAt is not null || sources.TeleportBaselineAt is not null),
        _ => sources.PetCanCount && sources.PetBaselineAt is not null
            || sources.IdentityIsLive && (sources.QuestBaselineAt is not null || sources.TeleportBaselineAt is not null),
    };
    private bool ScopedComplete(Soulcrest.App.Network.NetworkProgressSources sources) => Scope switch
    {
        "pet" => sources.PetCanCount && sources.PetBaselineAt is not null && !sources.PetFormatRejected,
        "exploration" => sources.IdentityIsLive && sources.QuestBaselineAt is not null && sources.TeleportBaselineAt is not null
            && !sources.QuestFormatRejected && !sources.TeleportFormatRejected && !sources.DungeonFormatRejected && !sources.KibeliskFormatRejected,
        _ => sources.InitialProgressConfirmed,
    };
    private string SourceState(Soulcrest.App.Network.NetworkProgressSources sources)
    {
        if (ScopedComplete(sources)) return "current";
        var hasActivity = Scope != "exploration" && sources.PetCanCount && sources.PetActivityAt is not null
            || Scope != "pet" && sources.IdentityIsLive && (sources.DungeonActivityAt is not null || sources.KibeliskActivityAt is not null);
        return HasScopedBaseline(sources) || hasActivity ? "partial" : "waiting";
    }
    private string StatusText(Soulcrest.App.Network.NetworkProgressSources sources, string state)
    {
        if (Scope == "pet")
        {
            if (!sources.PetCanCount) return "Pet-Netzwerkquelle aus. Aktiviere das Netzwerk-Tracking, um neue Souls zu erfassen.";
            if (sources.PetFormatRejected)
                return "Pet-Netzwerkformat nicht unterstützt. Neue Soul-Gewinne werden weiter erfasst; der vollständige Pet-Stand muss erneut empfangen werden.";
            return state switch
            {
                "current" => "Pet-Fortschritt aktuell.",
                "partial" => "Pet-Daten empfangen. Der vollständige Pet-Stand steht noch aus.",
                _ => "Pet-Erkennung bereit. Neue Souls zählen ohne Charaktererkennung; der vollständige Pet-Stand steht noch aus.",
            };
        }
        // Exploration still requires its own character context; pet readiness is independent.
        if (!sources.IdentityIsLive) return sources.Status;
        if (Scope == "exploration")
        {
            if (sources.QuestFormatRejected) return "Quest-Netzwerkformat nicht unterstützt. Pet-Erkennung läuft weiter.";
            if (sources.TeleportFormatRejected) return "Teleport-Netzwerkformat nicht unterstützt. Pet-Erkennung läuft weiter.";
            if (sources.DungeonFormatRejected) return "Netzwerkformat für Instanzabschlüsse nicht unterstützt. Bereits bestätigte Abschlüsse bleiben erhalten.";
            if (sources.KibeliskFormatRejected) return "Netzwerkformat für Kibelisk-Bindungen nicht unterstützt. Bereits bestätigte Bindungen bleiben erhalten.";
            if (sources.KibeliskActivityAt is not null && sources.QuestBaselineAt is null && sources.TeleportBaselineAt is null)
                return "Kibelisk-Bindung über das Netzwerk erfasst. Weitere Erkundungsdaten stehen noch aus.";
            if (sources.DungeonActivityAt is not null && sources.QuestBaselineAt is null && sources.TeleportBaselineAt is null)
                return "Instanzabschluss über das Netzwerk erfasst. Weitere Erkundungsdaten stehen noch aus.";
        }
        if (Scope == "exploration") return state switch
        {
            "current" => "Verfügbare Erkundungsdaten eingelesen. Bestätigte Abschlüsse und Kibelisk-Bindungen werden angezeigt.",
            "partial" => "Ein Teil der Erkundungsdaten wurde empfangen. Weitere Quellen stehen noch aus.",
            _ => "Charakter erkannt. Warte auf die Erkundungsdaten.",
        };
        return state == "current"
            ? "Die gemeinsame Pet-Sammlung und die verfügbaren Erkundungsdaten dieses Charakters wurden eingelesen."
            : sources.Status;
    }
    private static string Baseline(DateTimeOffset? at) => at is { } timestamp
        ? timestamp.ToLocalTime().ToString("g", System.Globalization.CultureInfo.GetCultureInfo(UiText.Language == "de" ? "de-DE" : "en-US"))
        : UiText.T("In dieser Sitzung noch nicht bestätigt");
    protected override void OnInitialized() { Network.Changed += Refresh; Settings.Changed += Refresh; }
    private void Refresh() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    public void Dispose() { _disposed = true; Network.Changed -= Refresh; Settings.Changed -= Refresh; }
}
