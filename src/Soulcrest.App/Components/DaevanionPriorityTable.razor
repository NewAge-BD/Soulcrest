@implements IAsyncDisposable
@using Soulcrest.Core.Daevanion
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Provider

<section class="dc-priority-card" data-priority-kind="@Kind" data-busy="@Busy.ToString().ToLowerInvariant()" @ref="_element">
    <header><div><h3>@UiText.T(Title)</h3><span>@UiText.F("{0} Einträge", Rows.Count)</span></div><label class="dc-weight">@UiText.T("Gewicht")<input type="number" min="0" max="100" value="@CategoryWeight" disabled="@Busy" aria-label="@UiText.F("Kategoriegewicht: {0}", UiText.T(Title))" @onchange="SetWeight" /></label></header>
    <div class="dc-priority-scroll">
        <table aria-label="@UiText.T(Title)" data-priority-table="@Kind">
            <thead><tr><th scope="col">@UiText.T("Priorität")</th><th scope="col">@UiText.T("Eintrag")</th><th scope="col" title="@UiText.T("Prioritätsgewicht im Modus Nach Priorität")">@UiText.T("Wert")</th><th scope="col">CP</th><th scope="col"><span class="dc-sr-only">@UiText.T("Verschieben")</span></th></tr></thead>
            @foreach (var zone in new[] { "required", "normal", "ignored" })
            {
                var required = zone == "required";
                var ignored = zone == "ignored";
                <tbody class="@(required ? "dc-required" : ignored ? "dc-ignore" : "dc-ranked")" data-priority-zone="@zone" data-drop-ignore="@ignored.ToString().ToLowerInvariant()" data-drop-required="@required.ToString().ToLowerInvariant()">
                    @if (required)
                    {
                        <tr class="dc-required-heading"><th colspan="5" scope="rowgroup">must have <span>@UiText.T("Alle passenden Nodes im Punktepool sind Pflicht")</span></th></tr>
                    }
                    else if (ignored)
                    {
                        <tr class="dc-ignore-heading"><th colspan="5" scope="rowgroup">ignore if possible <span>@UiText.T("Weich vermeiden")</span></th></tr>
                    }
                    else
                    {
                        <tr class="dc-normal-heading"><th colspan="5" scope="rowgroup">@UiText.T("Normale Prioritäten")</th></tr>
                    }
                    @foreach (var row in Rows.Where(row => row.Required == required && row.Ignored == ignored))
                    {
                        <tr class="@row.CostColorClass" draggable="@(!Busy ? "true" : "false")" data-priority-key="@row.Key" data-ignored="@ignored.ToString().ToLowerInvariant()" data-required="@required.ToString().ToLowerInvariant()" @key="row.Key">
                            <td class="dc-rank"><span aria-hidden="true" class="dc-grip">⠿</span>@(ignored ? "—" : row.Rank)</td>
                            <td class="dc-entry" title="@UiText.F("{0} · {1} Nodes", row.Label, row.NodeCount)">@if (row.IconPath is not null) { <img src="@row.IconPath" alt="" loading="lazy" /> }<span><span class="dc-entry-label">@row.Label</span><small>@UiText.F(required ? "Pflicht: {0} Nodes im Punktepool" : "{0} Nodes", required ? row.RequiredNodeCount : row.NodeCount)</small><span class="dc-node-costs">@foreach (var variant in row.CostVariants) { <span class="dc-node-cost dc-cost-@variant.Cost" data-node-cost="@variant.Cost" title="@UiText.F("{0} Nodes · {1} Punkte je Node", variant.NodeCount, variant.Cost)">@variant.DisplayAmount <span>· @UiText.F("{0} Pkt.", variant.Cost)</span></span> }</span>
                                @if (Kind != DaevanionPriorityKind.Stat)
                                {
                                    <span class="dc-skill-fields" data-skill-fields>
                                        <label>@UiText.T("Aktuell")<output aria-label="@UiText.F("{0}: aktuelle Skillstufe", row.Label)" data-skill-current="@row.Key">@(row.CurrentLevel?.ToString() ?? "—")</output></label>
                                        <label title="@UiText.T("Automatisch bestätigter Daevanion-Anteil der aktuellen Skillstufe.")">@UiText.T("Davon Board")<output aria-label="@UiText.F("{0}: aktuelle Boardstufen", row.Label)" data-skill-board-bonus="@row.Key">@(row.CurrentBoardBonus?.ToString() ?? "—")</output></label>
                                        <label>@UiText.T("Wunsch")<input type="number" min="0" max="40" step="1" value="@row.TargetLevel" placeholder="—" disabled="@Busy" aria-label="@UiText.F("{0}: Wunschlevel", row.Label)" @onchange="@(args => EditSkill(row, DaevanionSkillEditField.TargetLevel, args))" data-skill-target="@row.Key" /></label>
                                    </span>
                                    @if (required && row.TargetLevel is not null) { <small class="dc-target-note">@UiText.T("must have hat Vorrang vor dem Wunschlevel.")</small> }
                                }
                            </span></td>
                            <td class="dc-score">@row.Weight.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</td><td class="dc-unknown" title="@UiText.T("CP hängt von Ausgangswerten und der gesamten Route ab.")">—</td>
                            <td class="dc-row-actions"><button type="button" disabled="@Busy" title="@UiText.T("Nach oben")" aria-label="@UiText.F("{0} nach oben", row.Label)" @onclick="@(() => MoveArrow(row, -1))">↑</button><button type="button" disabled="@Busy" title="@UiText.T("Nach unten")" aria-label="@UiText.F("{0} nach unten", row.Label)" @onclick="@(() => MoveArrow(row, 1))">↓</button><button type="button" class="@(required ? "dc-required-toggle" : "")" disabled="@Busy" title="@UiText.T(required ? "Pflicht aufheben" : "Als Pflicht festlegen")" aria-label="@UiText.F(required ? "Pflicht für {0} aufheben" : "{0} als Pflicht festlegen", row.Label)" @onclick="@(() => Moved.InvokeAsync(new(Kind, row.Key, null, false, Required: !required)))">@(required ? "★" : "☆")</button><button type="button" disabled="@Busy" title="@UiText.T(ignored ? "Wieder priorisieren" : "Nach Möglichkeit ignorieren")" aria-label="@UiText.F(ignored ? "{0} wieder priorisieren" : "{0} nach Möglichkeit ignorieren", row.Label)" @onclick="@(() => Moved.InvokeAsync(new(Kind, row.Key, null, !ignored)))">@(ignored ? "+" : "−")</button></td>
                        </tr>
                    }
                    @if (!Rows.Any(row => row.Required == required && row.Ignored == ignored))
                    {
                        <tr class="dc-drop-empty"><td colspan="5">@UiText.T(required ? "Für Pflicht-Nodes hier ablegen" : ignored ? "Zum Ignorieren hier ablegen" : "Einträge hier priorisieren")</td></tr>
                    }
                </tbody>
            }
        </table>
    </div>
</section>

@code {
    [Parameter] public DaevanionPriorityKind Kind { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public IReadOnlyList<DaevanionPriorityDisplayRow> Rows { get; set; } = [];
    [Parameter] public int CategoryWeight { get; set; } = 100;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<DaevanionPriorityMove> Moved { get; set; }
    [Parameter] public EventCallback<int> WeightChanged { get; set; }
    [Parameter] public EventCallback<DaevanionSkillEdit> SkillChanged { get; set; }
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<DaevanionPriorityTable>? _reference;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Provider.GetService<IJSRuntime>() is not { } js) return;
        try
        {
            _module = await js.InvokeAsync<IJSObjectReference>("import", "./daevanion-calculator.js");
            if (_disposed) { await _module.DisposeAsync(); _module = null; return; }
            _reference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attachPriorityTable", _element, _reference);
        }
        catch (Exception error) when (error is JSException or InvalidOperationException or TaskCanceledException)
        { System.Diagnostics.Trace.TraceWarning("Daevanion priority drag: {0}", error.GetType().Name); }
    }

    [JSInvokable]
    public Task MoveFromDrop(string key, string? beforeKey, string? afterKey, bool ignored, bool required = false) => Busy || _disposed
        ? Task.CompletedTask : Moved.InvokeAsync(new(Kind, key, beforeKey, ignored, afterKey, required));

    private Task EditSkill(DaevanionPriorityDisplayRow row, DaevanionSkillEditField field, ChangeEventArgs args)
    {
        if (Busy || _disposed) return Task.CompletedTask;
        var text = args.Value?.ToString()?.Trim();
        if (string.IsNullOrEmpty(text)) return SkillChanged.InvokeAsync(new(row.Key, field, null));
        return int.TryParse(text, out var value) && value >= 0 && value <= (field == DaevanionSkillEditField.TargetLevel ? 40 : 255)
            ? SkillChanged.InvokeAsync(new(row.Key, field, value)) : Task.CompletedTask;
    }

    private Task SetWeight(ChangeEventArgs args) => int.TryParse(args.Value?.ToString(), out var value)
        ? WeightChanged.InvokeAsync(Math.Clamp(value, 0, 100)) : Task.CompletedTask;

    private Task MoveArrow(DaevanionPriorityDisplayRow row, int direction)
    {
        var group = Rows.Where(item => item.Ignored == row.Ignored && item.Required == row.Required).ToArray();
        var index = Array.FindIndex(group, item => item.Key == row.Key);
        if (direction < 0 && index > 0) return Moved.InvokeAsync(new(Kind, row.Key, group[index - 1].Key, row.Ignored, Required: row.Required));
        if (direction > 0 && index < group.Length - 1) return Moved.InvokeAsync(new(Kind, row.Key, null, row.Ignored, group[index + 1].Key, row.Required));
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("detachPriorityTable", _element); await _module.DisposeAsync(); }
            catch (Exception error) when (error is JSException or InvalidOperationException or TaskCanceledException) { }
        }
        _reference?.Dispose();
    }
}
