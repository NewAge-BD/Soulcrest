@using System.Globalization
@using Soulcrest.Core.Combat

@if (Buffs.Count == 0) { <p class="note">@UiText.T("Keine Effektereignisse gespeichert.")</p> }
else
{
    <div class="dps-buffs">
        @foreach (var buff in Buffs)
        {
            <details class="dps-buff"><summary><strong>@UiText.F("Effekt {0}", buff.BuffId)</strong>@if (buff.TargetEntity is { } target) { <span>@UiText.F("Bossziel {0}", BossTargets.ToList().IndexOf(target) + 1)</span> }<span>@UiText.T("Uptime"): @(buff.Uptime?.ToString("P1", Culture) ?? "—")</span><span>@UiText.T("Aktive Zeit"): @Time(buff.ActiveTicks)</span><span>@UiText.F("{0} Anwendungen", buff.Applications)</span></summary>
                @if (!buff.InitialStateKnown) { <p class="note">@UiText.T("Anfangszustand unbekannt; die beobachtete aktive Zeit ist keine bestätigte vollständige Uptime.")</p> }
                @if (buff.Intervals.Count == 0) { <p class="note">@UiText.T("Keine abgeschlossenen Intervalle gespeichert.")</p> }
                else
                {
                    <div class="dps-table"><table class="grid"><thead><tr><th>@UiText.T("Von")</th><th>@UiText.T("Bis")</th><th>@UiText.T("Quelle")</th><th>@UiText.T("Stapel")</th><th>@UiText.T("Level")</th></tr></thead><tbody>
                        @foreach (var interval in buff.Intervals) { <tr><td>@Time(interval.StartTicks)</td><td>@Time(interval.EndTicks)</td><td>@Source(interval.SourceParticipantId)</td><td>@(interval.StackCount?.ToString(Culture) ?? "—")</td><td>@(interval.Level?.ToString(Culture) ?? "—")</td></tr> }
                    </tbody></table></div>
                }
            </details>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<CombatBuffSummary> Buffs { get; set; } = [];
    [Parameter] public IReadOnlyList<CombatPlayerSummary> Participants { get; set; } = [];
    [Parameter] public IReadOnlyList<CombatEntityReference> BossTargets { get; set; } = [];
    private static CultureInfo Culture => CultureInfo.GetCultureInfo(UiText.Language == "de" ? "de-DE" : "en-US");
    private static string Time(long ticks) => TimeSpan.FromTicks(ticks).ToString(ticks >= TimeSpan.TicksPerHour ? @"h\:mm\:ss" : @"m\:ss", Culture);
    private string Source(string? id)
    {
        var index = Participants.ToList().FindIndex(p => p.Participant.ParticipantId == id);
        return index >= 0 ? Participants[index].Participant.Name ?? UiText.F("Teilnehmer {0}", index + 1) : "—";
    }
}
