<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Soulcrest.Core.Tests" />
    <PackageReference Include="Google.OrTools" Version="9.15.6755" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\pets\name-overrides.json" LogicalName="Soulcrest.PetNameOverrides.json" />
    <EmbeddedResource Include="..\..\data\pets\pet-ids.json" LogicalName="Soulcrest.PetIds.json" />
    <EmbeddedResource Include="..\..\data\pets\merchant-items.json" LogicalName="Soulcrest.MerchantPetItems.json" />
    <EmbeddedResource Include="..\..\data\pets\merchant-farm-regions.json" LogicalName="Soulcrest.PetFarmRegions.json" />
    <EmbeddedResource Include="..\..\data\pets\dungeon-soul-sources.json" LogicalName="Soulcrest.PetAcquisitionSources.json" />
    <EmbeddedResource Include="..\..\data\daevanion\catalog.json" LogicalName="Soulcrest.DaevanionCatalog.json" />
    <EmbeddedResource Include="..\..\data\combat\combat-catalog.json" LogicalName="Soulcrest.CombatCatalog.json" />
    <EmbeddedResource Include="..\..\data\combat\genus-insight-catalog.json" LogicalName="Soulcrest.GenusInsightCatalog.json" />
    <EmbeddedResource Include="..\..\data\combat\pantheon.json" LogicalName="Soulcrest.PantheonCatalog.json" />
    <EmbeddedResource Include="..\..\data\instances\catalog.json" LogicalName="Soulcrest.InstanceCatalog.json" Condition="Exists('..\..\data\instances\catalog.json')" />
    <!-- Public builds (user decision 2026-10-28): numeric world kinds only, without names or evidence. -->
    <EmbeddedResource Include="..\..\data\instances\map-kinds.json" LogicalName="Soulcrest.InstanceCatalog.json" Condition="!Exists('..\..\data\instances\catalog.json') And Exists('..\..\data\instances\map-kinds.json')" />
  </ItemGroup>
</Project>
